---
import '../styles/clinical-theme.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = 'Pluri Health | Healthtech de Gestão para Clínicas e Consultórios',
  description = 'A Pluri Health desenvolve tecnologia intuitiva e de alta performance para gestão de clínicas e consultórios de saúde. Conheça nossos sistemas e o recém-lançado Pluri Fisio.',
  canonicalUrl = 'https://plurihealth.com.br',
} = Astro.props;

// JSON-LD Structured Data Schema for SEO & GEO
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://plurihealth.com.br/#organization",
      "name": "Pluri Health",
      "url": "https://plurihealth.com.br",
      "logo": "https://plurihealth.com.br/branding/logo/pluri_health_logo_gradient.png",
      "description": "Healthtech brasileira voltada ao desenvolvimento de soluções completas de gestão, prontuário eletrônico e rotina ágil para clínicas e consultórios.",
      "sameAs": [
        "https://plurifisio.com.br"
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://plurifisio.com.br/#software",
      "name": "Pluri Fisio",
      "applicationCategory": "HealthApplication",
      "operatingSystem": "Web, iOS, Android",
      "url": "https://plurifisio.com.br",
      "description": "Primeira vertical da Pluri Health voltada exclusivamente para fisioterapia, com evolução na maca em 90 segundos, agenda e pacotes de sessões.",
      "publisher": {
        "@id": "https://plurihealth.com.br/#organization"
      }
    }
  ]
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="sistema para fisioterapia no celular, ficha de paciente no whatsapp, agenda para consultorio simples, prontuario eletronico facil, controle de pacientes fisioterapia" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://plurifisio.com.br/branding/logo/pluri_health_logo_gradient.png" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://plurifisio.com.br/branding/logo/pluri_health_logo_gradient.png" />

    <!-- Theme Color Light Clean -->
    <meta name="theme-color" content="#f8fafc" />

    <!-- Google Fonts Preconnect & Optimized Load (Plus Jakarta Sans, Outfit, Lexend) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />

    <!-- JSON-LD Schema Script for Search Engines & Generative AI Indexing -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
