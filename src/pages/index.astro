---
import Layout from '../layouts/Layout.astro';

// Cycling logic and data matching Lovable component exactly
const CYCLES = [
  { id: "free", label: "Degustação grátis" },
  { id: "mensal", label: "Mensal" },
  { id: "trimestral", label: "Trimestral", note: "-10%" },
  { id: "anual", label: "Anual", note: "-25%" },
];

const PLANS = [
  {
    id: "solo",
    name: "Profissional Solo",
    tagline: "1 profissional de saúde",
    monthly: 59,
    features: [
      "1 acesso simultâneo individual",
      "Atendimentos e pacientes ilimitados",
      "Prontuário eletrônico e anamnese",
      "Agenda e controle financeiro",
    ],
    cta: "Contratar Solo",
    featured: false,
  },
  {
    id: "pro",
    name: "Clínica Pro",
    tagline: "Equipes e consultórios · base 4 assentos",
    monthly: 139,
    features: [
      "4 acessos simultâneos inclusos",
      "Colaboradores ilimitados (30 vagas)",
      "Permissões avançadas (RBAC)",
      "Agendas compartilhadas e relatórios",
    ],
    cta: "Contratar Clínica Pro",
    featured: true,
  },
  {
    id: "enterprise",
    name: "Enterprise",
    tagline: "Alta escala · base 10 assentos",
    monthly: 299,
    features: [
      "10 acessos simultâneos inclusos",
      "Até 100 profissionais cadastrados",
      "Assentos extras por R$ 15/mês (-40%)",
      "Múltiplas unidades e auditoria",
    ],
    cta: "Contratar Enterprise",
    featured: false,
  },
];
---

<Layout 
  title="Pluri Health — Lançamento do Pluri Fisio"
  description="Pluri Health: prontuário, agenda e financeiro em um só lugar. Conheça o Pluri Fisio, feito para fisioterapeutas. Teste grátis por 7 dias."
>
  <a
    href="#conteudo"
    class="btn-primary t-small sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60]"
  >
    Pular para o conteúdo
  </a>

  <!-- Header Fixo Exato do Lovable -->
  <header class="lovable-header">
    <nav aria-label="Principal" class="header-nav">
      <a href="#lancamento" class="t-small brand-logo">
        <img
          src="/branding/logo/pluri_health_icon_gradient.svg"
          alt=""
          class="brand-icon"
          width="26"
          height="26"
        />
        <span>Pluri&nbsp;Health</span>
      </a>
      <ul class="nav-links">
        <li>
          <a href="#plataforma" class="t-small nav-link">
            A plataforma
          </a>
        </li>
        <li>
          <a href="#como-funciona" class="t-small nav-link">
            Como funciona
          </a>
        </li>
        <li>
          <a href="#planos" class="t-small nav-link">
            Planos
          </a>
        </li>
      </ul>
      <a href="#planos" class="btn-clay t-small header-btn">
        Testar grátis
      </a>
    </nav>
  </header>

  <!-- Main Container com Snap de Página Inteira (100svh) -->
  <main id="conteudo" class="snap-main-container">
    
    <!-- 1 — Lançamento Pluri Fisio -->
    <section
      id="lancamento"
      aria-labelledby="lancamento-titulo"
      class="snap-page hero-aurora hero-section"
    >
      <div aria-hidden="true" class="hero-grid"></div>
      <div
        aria-hidden="true"
        class="hero-orbit orbit-1"
      ></div>
      <div
        aria-hidden="true"
        class="hero-orbit orbit-2"
      ></div>
      
      <div class="hero-brand-top">
        <img
          src="/branding/logo/pluri_health_icon_gradient.svg"
          alt="Pluri Health"
          class="hero-logo-mark"
          width="54"
          height="54"
        />
        <span class="t-small hero-badge">
          Lançamento oficial
        </span>
      </div>
      <h1 id="lancamento-titulo" class="t-display hero-title">
        Pluri&nbsp;Fisio.
      </h1>
      <p class="t-lead hero-lead">
        A prática da fisioterapia, inteira em uma tela. Evolução, agenda e pacotes de sessões.
      </p>
      <div class="hero-actions">
        <a href="#planos" class="btn-clay hero-btn">
          Começar grátis 
          <svg aria-hidden="true" class="icon-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#plataforma" class="btn-ink hero-btn">
          Saiba mais
        </a>
      </div>
    </section>

    <!-- 2 — O que é a Pluri Health (Com imagem do tablet em azul) -->
    <section
      id="plataforma"
      aria-labelledby="plataforma-titulo"
      class="snap-page platform-section"
    >
      <!-- Visualizador com Alternância entre as 3 Versões da Seção 2 -->
      <div class="platform-text-box" id="platformTextBox">
        
        <!-- Controles de Alternância (Setas < e > e indicador de versão) -->
        <div class="platform-mode-switch" aria-label="Alternar versão da seção">
          <div class="mode-switch-left">
            <span class="mode-counter" id="platformModeCounter">1/3</span>
            <span class="mode-label" id="platformModeLabel">Opção 1: Pesquisas + Foto Vertical</span>
          </div>
          <div class="mode-nav-arrows">
            <button
              type="button"
              id="btnPrevPlatformMode"
              class="btn-arrow-toggle"
              title="Versão anterior"
              aria-label="Versão anterior"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button
              type="button"
              id="btnNextPlatformMode"
              class="btn-arrow-toggle"
              title="Próxima versão"
              aria-label="Próxima versão"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </div>

        <!-- VERSÃO 1 (Ativa): Pesquisas Expandidas + Foto Vertical Humana da Rotina -->
        <div class="platform-view platform-view-v1 active" id="platformViewV1">
          <span class="platform-kicker">O custo invisível da desorganização</span>
          <h2 id="plataforma-titulo" class="t-title platform-title platform-title-conversion">
            A clínica não fecha por falta de técnica. Fecha por má gestão.
          </h2>
          <p class="t-lead platform-lead">
            Fichas em papel, planilhas soltas e WhatsApp pessoal drenam o faturamento e a sanidade do fisioterapeuta todos os meses.
          </p>

          <!-- Cards de Evidências Reais com Tags Sóbrias e Elegantes -->
          <div class="research-evidence-grid">
            <div class="evidence-card">
              <div class="evidence-stat-header">
                <span class="stat-number">60%</span>
                <span class="stat-badge stat-badge-sobriety">Sustentabilidade</span>
              </div>
              <p class="evidence-text">
                das clínicas e consultórios de saúde no Brasil <strong>fecham em até 5 anos</strong> por deficiência no controle financeiro e processos manuais.
              </p>
              <a
                href="https://saudeempreende.com.br"
                target="_blank"
                rel="noopener noreferrer"
                class="evidence-source-link"
              >
                Fonte: Levantamento Sebrae
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>

            <div class="evidence-card">
              <div class="evidence-stat-header">
                <span class="stat-number">2h</span>
                <span class="stat-badge stat-badge-time">Tempo Clínico</span>
              </div>
              <p class="evidence-text">
                gastas em burocracias e prontuários <strong>para cada 1h atendendo</strong> pacientes, forçando horas extras em casa à noite.
              </p>
              <a
                href="https://www.acpjournals.org/doi/10.7326/M16-0961"
                target="_blank"
                rel="noopener noreferrer"
                class="evidence-source-link"
              >
                Estudo: Annals of Internal Medicine
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>
          </div>

          <!-- Solução do Pluri Fisio -->
          <div class="solution-reassurance">
            <span class="reassurance-tag">Como o Pluri Fisio protege sua rotina:</span>
            <ul class="reassurance-list">
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span><strong>Evolução em 40s:</strong> reaproveite a conduta anterior e anote apenas o que mudou.</span>
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span><strong>Pacotes e Financeiro amarrados:</strong> zero atendimentos esquecidos sem cobrança.</span>
              </li>
            </ul>
          </div>

          <div class="conversion-actions">
            <a href="#planos" class="btn-clay platform-cta-primary">
              Proteger minha clínica com 20 atendimentos grátis
              <svg aria-hidden="true" class="icon-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <span class="cta-micro-guarantee">Sem cartão • Importação grátis de fichas antigas de papel</span>
          </div>
        </div>

        <!-- VERSÃO 2: Cards com Imagem Individual Dedicada para Cada Pesquisa (Largura Total sem lateral) -->
        <div class="platform-view platform-view-v2" id="platformViewV2">
          <div class="v2-header-block">
            <span class="platform-kicker">Evidências científicas e de mercado</span>
            <h2 class="t-title platform-title platform-title-conversion">
              A dor da gestão e o custo do tempo em números reais.
            </h2>
            <p class="t-lead platform-lead">
              Veja por que sistemas amadores, anotações em papel e desorganização financeira ameaçam consultórios de saúde:
            </p>
          </div>

          <!-- 2 Blocos Grandes com Imagens Próprias de Alto Impacto -->
          <div class="split-research-cards">
            
            <!-- Card 1: 60% com foto editorial de desorganização de recibos/contas vs app financeiro -->
            <div class="split-research-card">
              <div class="split-card-media">
                <img
                  src="/images/research_finance_cards.jpg"
                  alt="Mesa de clínica com faturas manuais e aplicativo financeiro com indicadores verdes"
                  loading="lazy"
                  width="1280"
                  height="720"
                  class="split-media-img"
                />
              </div>
              <div class="split-card-content">
                <div class="evidence-stat-header">
                  <span class="stat-number">60%</span>
                  <span class="stat-badge stat-badge-sobriety">Sustentabilidade Clínica</span>
                </div>
                <p class="evidence-text">
                  das clínicas e consultórios de saúde no Brasil <strong>fecham suas portas em até 5 anos</strong> por deficiências no controle financeiro, fluxo de caixa e gestão de agendamentos.
                </p>
                <a href="https://saudeempreende.com.br" target="_blank" rel="noopener noreferrer" class="evidence-source-link">
                  Levantamento Sebrae Nacional
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                </a>
              </div>
            </div>

            <!-- Card 2: 2h com foto real de relógio marcando 20h e papelada noturna -->
            <div class="split-research-card">
              <div class="split-card-media">
                <img
                  src="/images/research_clock_time.jpg"
                  alt="Relógio de mesa marcando após 20h na clínica com prontuários de papel e smartphone com evolução rápida"
                  loading="lazy"
                  width="1280"
                  height="720"
                  class="split-media-img"
                />
              </div>
              <div class="split-card-content">
                <div class="evidence-stat-header">
                  <span class="stat-number">2h</span>
                  <span class="stat-badge stat-badge-time">Tempo & Sobrecarga</span>
                </div>
                <p class="evidence-text">
                  gastas em prontuários e tarefas burocráticas <strong>para cada 1h de consulta clínica</strong>, forçando mais de 1 a 2 horas extras de trabalho não remunerado em casa à noite.
                </p>
                <a href="https://www.acpjournals.org/doi/10.7326/M16-0961" target="_blank" rel="noopener noreferrer" class="evidence-source-link">
                  Estudo: Annals of Internal Medicine
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                </a>
              </div>
            </div>

          </div>

          <div class="conversion-actions v2-center-actions">
            <a href="#planos" class="btn-clay platform-cta-primary">
              Eliminar a sobrecarga com 20 atendimentos grátis
              <svg aria-hidden="true" class="icon-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <span class="cta-micro-guarantee">Prontuário, agenda e financeiro em 1 só lugar • Sem cartão de crédito</span>
          </div>
        </div>

        <!-- VERSÃO 3: Minimalista Original (Toda a clínica. Um sistema.) -->
        <div class="platform-view platform-view-v3" id="platformViewV3">
          <h2 class="t-title platform-title">
            Toda a clínica. Um sistema.
          </h2>
          <p class="t-lead platform-lead">
            Prontuário, agenda e financeiro conversando entre si — sem planilhas, sem retrabalho.
          </p>
          <a href="#planos" class="btn-primary btn-primary-hoverable t-small platform-cta">
            Ver planos 
            <svg aria-hidden="true" class="icon-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

      </div>

      <!-- Caixa de Imagem Lateral Responsiva com Alternância Conforme a Versão -->
      <div class="platform-image-box" id="platformImageBox">
        <!-- Imagem para Versão 1: Foto Vertical da Fisioterapeuta na Rotina -->
        <img
          id="platformImgV1"
          src="/images/fisio_routine_vertical.jpg"
          alt="Fisioterapeuta em consultório moderno utilizando o aplicativo com tranquilidade"
          loading="lazy"
          width="1200"
          height="1600"
          class="platform-img platform-img-toggle active"
        />
        <!-- Imagem para Versão 2 e 3: Tablet Blue -->
        <img
          id="platformImgV3"
          src="/images/platform_tablet_blue.jpg"
          alt="Painel da Pluri Health exibido em um tablet"
          loading="lazy"
          width="1408"
          height="1408"
          class="platform-img platform-img-toggle"
        />
      </div>
    </section>

    <!-- 3 — Como funciona (Fluxo real Pluri Health em 6 etapas) -->
    <section
      id="como-funciona"
      aria-labelledby="como-titulo"
      class="snap-page how-section"
    >
      <div class="how-header-row">
        <h2 id="como-titulo" class="t-title how-title">
          Seis etapas. Nenhuma fricção.
        </h2>
        <button type="button" class="btn-features-trigger" id="btnOpenFeaturesModal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>Conheça as principais funcionalidades</span>
        </button>
      </div>

      <ol class="how-steps-grid">
        <!-- Passo 1: Auto-cadastro -->
        <li class="how-step-item">
          <div class="how-step-top-line">
            <div class="how-step-icon">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="20" y1="8" x2="20" y2="14"></line>
                <line x1="23" y1="11" x2="17" y2="11"></line>
              </svg>
            </div>
            <span class="step-num">01</span>
          </div>
          <h3 class="step-title">
            Auto-cadastro
          </h3>
          <p class="step-desc">
            O paciente preenche a ficha no celular antes de chegar, poupando tempo na maca.
          </p>
        </li>

        <!-- Passo 2: Agenda Inteligente -->
        <li class="how-step-item">
          <div class="how-step-top-line">
            <div class="how-step-icon">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <span class="step-num">02</span>
          </div>
          <h3 class="step-title">
            Agenda Ágil
          </h3>
          <p class="step-desc">
            Marcação rápida com visão clara de quem chegou, aguarda ou está em atraso.
          </p>
        </li>

        <!-- Passo 3: Anamnese Customizada -->
        <li class="how-step-item">
          <div class="how-step-top-line">
            <div class="how-step-icon">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>
            <span class="step-num">03</span>
          </div>
          <h3 class="step-title">
            Anamnese Sob Medida
          </h3>
          <p class="step-desc">
            Crie formulários no editor no-code ou use modelos prontos da nossa biblioteca.
          </p>
        </li>

        <!-- Passo 4: Tratamento Facilitado -->
        <li class="how-step-item">
          <div class="how-step-top-line">
            <div class="how-step-icon">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <span class="step-num">04</span>
          </div>
          <h3 class="step-title">
            Tratamento Facilitado
          </h3>
          <p class="step-desc">
            Prescreva condutas, exercícios e ciclos terapêuticos de forma ágil ao lado da maca.
          </p>
        </li>

        <!-- Passo 5: Pagamentos & Planos -->
        <li class="how-step-item">
          <div class="how-step-top-line">
            <div class="how-step-icon">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                <line x1="1" y1="10" x2="23" y2="10"></line>
              </svg>
            </div>
            <span class="step-num">05</span>
          </div>
          <h3 class="step-title">
            Pagamentos & Planos
          </h3>
          <p class="step-desc">
            Sessões avulsas, pacotes com dedução automática e controle financeiro em dia.
          </p>
        </li>

        <!-- Passo 6: Evolução & Estatísticas -->
        <li class="how-step-item">
          <div class="how-step-top-line">
            <div class="how-step-icon">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
              </svg>
            </div>
            <span class="step-num">06</span>
          </div>
          <h3 class="step-title">
            Evolução & Métricas
          </h3>
          <p class="step-desc">
            Evolua em 60s puxando a última sessão e acompanhe a linha do tempo e estatísticas.
          </p>
        </li>
      </ol>
    </section>

    <!-- 4 — Planos (Com cálculo reativo idêntico ao TSX) -->
    <section
      id="planos"
      aria-labelledby="planos-titulo"
      class="snap-page plans-section"
    >
      <div class="plans-header">
        <h2 id="planos-titulo" class="t-title">
          Escolha seu plano.
        </h2>
        <div
          role="group"
          aria-label="Ciclo de cobrança"
          class="cycles-switcher"
        >
          {CYCLES.map((c) => (
            <button
              type="button"
              data-cycle={c.id}
