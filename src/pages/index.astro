---
import Layout from '../layouts/Layout.astro';
import HeaderNav from '../components/home/HeaderNav.astro';
import HeroSection from '../components/home/HeroSection.astro';
import PlatformSection from '../components/home/PlatformSection.astro';
import FisioLaunchSection from '../components/home/FisioLaunchSection.astro';
import WorkflowSection from '../components/home/WorkflowSection.astro';
import EcosystemSection from '../components/home/EcosystemSection.astro';
import PricingSection from '../components/home/PricingSection.astro';
import FeaturesModal from '../components/home/FeaturesModal.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Pluri Health | Healthtech de Gestão para Clínicas e Consultórios"
  description="A Pluri Health desenvolve tecnologia intuitiva e de alta performance para gestão de clínicas e consultórios de saúde. Conheça nossos sistemas e o recém-lançado Pluri Fisio."
>
  <a
    href="#conteudo"
    class="btn-primary t-small sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60]"
  >
    Pular para o conteúdo
  </a>

  <!-- Header Fixo -->
  <HeaderNav />

  <!-- Main Container com Snap de Página Inteira (100svh) -->
  <main id="conteudo" class="snap-main-container">
    <!-- 1 — Pluri Health: Healthtech de Gestão & Lançamento Pluri Fisio -->
    <HeroSection />

    <!-- 2 — Lançamento Pluri Fisio: Primeira vertical com link direto plurifisio.com.br -->
    <FisioLaunchSection />

    <!-- 3 — Gestão de Clínicas: A Solução Inteligente Pluri Health -->
    <PlatformSection />

    <!-- 4 — Como funciona na Prática Clínica (Fluxo sem fricção em 6 etapas) -->
    <WorkflowSection />

    <!-- 5 — Ecossistema Pluri Health (Verticais Especializadas) -->
    <EcosystemSection />

    <!-- 6 — Planos para Profissionais e Clínicas -->
    <PricingSection />

    <!-- 7 — Rodapé Institucional -->
    <div class="snap-page-footer">
      <Footer />
    </div>
  </main>

  <!-- Modal de Funcionalidades Práticas da Rotina Clínica -->
  <FeaturesModal />
</Layout>

<script>
  import { setupModal, setupWorkflowResponsiveCarousel } from '../scripts/home-interactions';
  import { setupPricing } from '../scripts/pricing-bento';
  import { setupTrafficAttribution } from '../scripts/traffic-attribution';

  function init() {
    setupTrafficAttribution();
    setupPricing();
    setupModal();
    setupWorkflowResponsiveCarousel();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>

<style>
  .snap-page-footer {
    scroll-snap-align: start;
    width: 100%;
    position: relative;
    background: var(--bg-canvas, #FAFBFD);
  }
</style>
