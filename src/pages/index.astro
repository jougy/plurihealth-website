  }

  .platform-section.mode-v2-active .platform-image-box {
    display: none !important;
  }

  .platform-section.mode-v2-active .platform-text-box {
    max-width: 1400px;
    margin-inline: auto;
    width: 100%;
    padding-inline: max(1.5rem, 5vw);
  }

  .platform-view-v2 {
    gap: clamp(1rem, 2vmin, 1.5rem);
  }

  .v2-header-block {
    text-align: left;
    max-width: 80ch;
  }

  .split-research-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2.5vmin, 2rem);
    margin-block: 0.5rem;
  }

  @media (min-width: 768px) {
    .split-research-cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  .split-research-card {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.04);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  .split-research-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.08);
  }

  .split-card-media {
    height: clamp(160px, 22vmin, 260px);
    overflow: hidden;
    background: var(--sand);
    position: relative;
  }

  .split-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .split-research-card:hover .split-media-img {
    transform: scale(1.03);
  }

  .split-card-content {
    padding: clamp(1rem, 2.4vmin, 1.6rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    flex: 1;
  }

  .v2-center-actions {
    align-items: flex-start;
    margin-top: 0.5rem;
  }

  /* Ações de Conversão Comuns */
  .conversion-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .platform-cta-primary {
    min-height: 3rem;
    padding-inline: 1.75rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .cta-micro-guarantee {
    font-size: 0.78rem;
    color: var(--muted-foreground);
    letter-spacing: 0.02em;
    padding-left: 0.25rem;
  }

  /* ESTILOS DA VERSÃO 3: Minimalista Original */
  .platform-view-v3 {
    gap: 2.5vmin;
  }

  .platform-title {
    max-width: 16ch;
    color: var(--foreground);
  }

  .platform-cta {
    align-self: flex-start;
  }

  /* Imagens Laterais */
  .platform-image-box {
    position: relative;
    min-height: 0;
    background-color: var(--sand);
    overflow: hidden;
  }

  .platform-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .platform-img-toggle {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: fadeInView 0.35s ease forwards;
  }

  .platform-img-toggle.active {
    display: block;
  }

  /* Ajustes Mobile específicos para a Seção 2 (#plataforma) */
  @media (max-width: 768px) {
    .platform-section {
      height: 100svh !important;
      height: 100dvh !important;
      min-height: 100svh;
      max-height: 100svh;
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-start !important;
      padding-top: 3.75rem !important;
      padding-bottom: 0.75rem !important;
      overflow: hidden !important;
      touch-action: pan-y;
    }

    .platform-image-box {
      display: none !important;
    }

    .platform-text-box {
      width: 100% !important;
      height: calc(100% - 0.25rem) !important;
      padding-inline: 1rem !important;
      padding-block: 0.25rem 0.5rem !important;
      justify-content: flex-start !important;
      overflow-y: auto !important;
      -webkit-overflow-scrolling: touch;
    }

    .platform-mode-switch {
      position: relative;
      z-index: 10;
      margin-bottom: 0.4rem;
      padding-bottom: 0.4rem;
      flex-shrink: 0;
    }

    .mode-label {
      font-size: 0.68rem;
      padding: 0.2rem 0.45rem;
      max-width: 180px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .btn-arrow-toggle {
      width: 2.25rem;
      height: 2.25rem;
      min-width: 2.25rem;
      min-height: 2.25rem;
      background: rgba(0, 114, 255, 0.08);
      border-color: rgba(0, 114, 255, 0.25);
    }

    .platform-kicker {
      font-size: 0.7rem;
      margin-bottom: 0.2rem;
    }

    .platform-title-conversion {
      font-size: clamp(1.35rem, 5.2vw, 1.65rem);
      line-height: 1.15;
      max-width: 28ch;
    }

    .platform-lead {
      font-size: 0.85rem;
      line-height: 1.35;
      margin-top: 0.25rem;
      max-width: 100%;
    }

    .research-evidence-grid {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      margin-block: 0.4rem;
    }

    .evidence-card {
      padding: 0.65rem 0.75rem;
      gap: 0.35rem;
    }

    .stat-number {
      font-size: 1.4rem;
    }

    .evidence-text {
      font-size: 0.78rem;
      line-height: 1.35;
    }

    .solution-reassurance {
      padding: 0.5rem 0.75rem;
      gap: 0.35rem;
      margin-top: 0.3rem;
    }

    .reassurance-list li {
      font-size: 0.76rem;
      line-height: 1.35;
    }

    .conversion-actions {
      margin-top: 0.4rem;
      gap: 0.35rem;
      width: 100%;
    }

    .platform-cta-primary {
      width: 100%;
      min-height: 2.75rem;
      font-size: 0.85rem;
      padding-inline: 1rem;
      text-align: center;
      justify-content: center;
    }

    .cta-micro-guarantee {
      font-size: 0.72rem;
      text-align: center;
      width: 100%;
    }

    /* Versão 2 no mobile */
    .split-research-cards {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      margin-block: 0.4rem;
    }

    .split-card-media {
      height: 110px;
    }

    .split-card-content {
      padding: 0.65rem 0.75rem;
      gap: 0.4rem;
    }

    /* Versão 3 no mobile */
    .platform-view-v3 .platform-title {
      font-size: 1.65rem;
    }
  }

  /* 3 — Como Funciona (Layout Inteligente 3x2 com Alta Legibilidade) */
  .how-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 3vmin, 2.5rem);
    background-color: var(--ink);
    padding-inline: max(1.5rem, 6vmin);
    padding-top: clamp(4rem, 6vmin, 5rem);
    padding-bottom: clamp(1.5rem, 3vmin, 2.5rem);
    color: var(--bone);
  }

  .how-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .how-title {
    max-width: 18ch;
    color: var(--bone);
    font-size: clamp(2.2rem, 5.5vmin, 3.8rem);
    line-height: 1.08;
  }

  .btn-features-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(255, 255, 255, 0.12);
    color: var(--bone);
    border: 1px solid rgba(255, 255, 255, 0.28);
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-size: clamp(0.85rem, 1.6vmin, 1rem);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-features-trigger:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  /* Grid 3 Colunas x 2 Linhas: muito mais espaço e leitura confortável */
  .how-steps-grid {
    display: grid;
    gap: clamp(1.2rem, 2.4vmin, 2rem);
    list-style: none;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .how-steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .how-steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .how-step-item {
    border-top: 1px solid rgba(251, 250, 248, 0.22);
    padding-top: clamp(0.9rem, 1.8vmin, 1.4rem);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .how-step-item:hover {
    border-color: rgba(255, 255, 255, 0.55);
    transform: translateY(-2px);
  }

  .how-step-top-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }

  .how-step-icon {
    color: var(--clay);
    background: rgba(0, 114, 255, 0.15);
    padding: 0.5rem;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .step-num {
    opacity: 0.5;
    font-size: clamp(0.82rem, 1.5vmin, 0.95rem);
    font-family: ui-monospace, monospace;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .step-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.18rem, 2.2vmin, 1.55rem);
    color: var(--bone);
    margin-top: 0.2rem;
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  .step-desc {
    font-family: var(--font-accessible);
    font-weight: 400;
    letter-spacing: 0.015em;
    word-spacing: 0.05em;
    opacity: 0.95;
    line-height: 1.62;
    font-size: clamp(1rem, 1.85vmin, 1.25rem);
    color: var(--bone);
    max-width: 38ch;
  }

  /* Ajustes Mobile específicos para a Seção 3 (#como-funciona) */
  @media (max-width: 768px) {
    .how-section {
      height: 100svh !important;
      height: 100dvh !important;
      min-height: 100svh;
      max-height: 100svh;
      padding-top: 3.75rem !important;
      padding-bottom: 0.75rem !important;
      padding-inline: 1rem !important;
      justify-content: flex-start !important;
      gap: 0.6rem !important;
      overflow: hidden !important;
    }

    .how-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
      flex-shrink: 0;
    }

    .how-title {
      font-size: 1.55rem !important;
      line-height: 1.15;
    }

    .btn-features-trigger {
      padding: 0.45rem 0.9rem;
      font-size: 0.78rem;
      gap: 0.4rem;
    }

    .btn-features-trigger svg {
      width: 15px;
      height: 15px;
    }

    .how-steps-grid {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      flex: 1;
      padding-bottom: 1rem;
      padding-right: 0.25rem;
    }

    .how-step-item {
      padding-top: 0.65rem;
      gap: 0.2rem;
    }

    .how-step-icon {
      padding: 0.35rem;
      border-radius: 8px;
    }

    .how-step-icon svg {
      width: 18px;
      height: 18px;
    }

    .step-title {
      font-size: 1.1rem;
      margin-top: 0.1rem;
      margin-bottom: 0.15rem;
    }

    .step-desc {
      font-size: 0.88rem;
      line-height: 1.4;
      opacity: 0.9;
    }
  }

  /* 4 — Planos */
  .plans-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2vmin;
    background-color: var(--background);
    padding-inline: max(1rem, 4vmin);
    padding-bottom: 2vmin;
    padding-top: max(4.5rem, 8vmin);
  }

  .plans-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5vmin;
    text-align: center;
  }

  .cycles-switcher {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    border-radius: 999px;
    background-color: var(--sand);
    padding: 0.25rem;
  }

  .cycle-btn {
    min-height: 2.75rem;
    border-radius: 999px;
    padding-inline: max(0.9rem, 1.8vmin);
    font-weight: 500;
    color: var(--muted-foreground);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .cycle-btn:hover {
    color: var(--foreground);
  }

  .cycle-btn.active {
    background-color: var(--ink);
    color: var(--bone);
  }

  .cycle-note {
    margin-left: 0.5rem;
    color: var(--clay);
  }

  .cycle-btn.active .cycle-note {
    color: var(--sage);
  }

  .plans-list {
    margin-inline: auto;
    display: flex;
    width: 100%;
    max-width: 1500px;
    min-height: 0;
    flex: 1;
    scroll-snap-type: x mandatory;
    gap: 2vmin;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 0.25rem;
  }

  @media (min-width: 1024px) {
    .plans-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      overflow-x: hidden;
    }
  }

  .plan-card {
    display: flex;
    min-height: 0;
    width: 86%;
    flex-shrink: 0;
    scroll-snap-align: center;
    flex-direction: column;
    gap: 1.4vmin;
    border-radius: 1.5rem;
    border: 1px solid var(--border);
    padding: max(1rem, 2.4vmin);
    background-color: var(--card);
  }

  @media (min-width: 640px) {
    .plan-card {
      width: 46%;
    }
  }

  @media (min-width: 1024px) {
    .plan-card {
      width: auto;
      flex-shrink: 1;
    }
  }

  .plan-featured {
    border-color: var(--clay);
    background-color: var(--sand);
  }

  .plan-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .text-muted {
    color: var(--muted-foreground);
  }

  .recommended-tag {
    flex-shrink: 0;
    border-radius: 999px;
    background-color: var(--clay);
    padding: 0.25rem 0.75rem;
    font-weight: 500;
    color: var(--bone);
  }

  .plan-price-main {
    font-size: clamp(1.6rem, 4.2vmin, 3rem);
    line-height: 1;
  }

  .plan-features-list {
    margin-bottom: 0.5vmin;
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    gap: 1vmin;
    overflow: hidden;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .icon-check {
    margin-top: 0.2rem;
    flex-shrink: 0;
    color: var(--sage);
  }

  .plan-cta-btn {
    width: 100%;
    text-align: center;
  }

  .plans-footer-note {
    text-align: center;
    color: var(--muted-foreground);
  }

  .mobile-only {
    display: inline;
  }

  @media (min-width: 1024px) {
    .mobile-only {
      display: none;
    }
  }

  /* Modal de Funcionalidades */
  .features-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: rgba(20, 22, 25, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 2vmin, 2rem);
  }

  .features-modal-overlay.is-active {
    display: flex;
  }

  .features-modal-content {
    background: var(--card);
    width: 100%;
    max-width: 860px;
    max-height: 88vh;
    border-radius: var(--radius-3xl);
    border: 1px solid var(--border);
    padding: clamp(1.5rem, 3.5vmin, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    overflow-y: auto;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.15);
  }

  .modal-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .modal-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--clay);
    text-transform: uppercase;
  }

  .modal-heading {
    font-size: clamp(1.5rem, 3vmin, 2rem);
    color: var(--foreground);
    margin-top: 0.25rem;
    line-height: 1.15;
  }

  .modal-subheading {
    color: var(--muted-foreground);
    margin-top: 0.25rem;
  }

  .modal-close-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--sand);
    color: var(--foreground);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .modal-close-btn:hover {
    background: var(--border);
    transform: scale(1.05);
  }

  .modal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 680px) {
    .modal-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .modal-feature-box {
    background: var(--sand);
    border: 1px solid rgba(0, 0, 0, 0.04);
    border-radius: 1.25rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .feature-box-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.5rem;
  }

  .feature-icon-badge {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #ffffff;
    color: var(--clay);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-box-header strong {
    font-size: 0.95rem;
    color: var(--foreground);
    font-weight: 600;
  }

  .modal-feature-box p {
    font-size: 0.825rem;
    color: var(--muted-foreground);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  /* Relógio & Financeiro Chips */
  .clock-mini-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }

  .clock-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    font-size: 0.725rem;
    font-weight: 500;
    color: var(--foreground);
  }

  .chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .dot-green { background: #16a34a; }
  .dot-blue { background: #0284c7; }
  .dot-orange { background: #ea580c; }
  .dot-red { background: #dc2626; }

  /* Recorrência Semanal (D, S, T, Q, Q, S, S) */
  .recurrence-mini-preview {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    margin-top: 0.35rem;
    width: fit-content;
  }

  .day-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--muted-foreground);
    background: transparent;
  }

  .day-active {
    background: #0284c7;
    color: #ffffff;
  }

  .recurrence-label {
    font-size: 0.72rem;
    color: var(--muted-foreground);
    margin-left: 0.35rem;
    font-weight: 500;
  }

  /* Tags de Linhas de Cuidado */
  .tags-mini-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }

  .tag-pill {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .tag-purple {
    background: #ede9fe;
    color: #5b21b6;
  }

  .tag-peach {
    background: #ffedd5;
    color: #9a3412;
  }

  .tag-blue {
    background: #e0f2fe;
    color: #0369a1;
  }

  .tag-violet {
    background: #fae8ff;
    color: #86198f;
  }

  /* Atalhos de Teclado */
  .shortcuts-mini-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }

  .shortcut-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.2rem 0.5rem;
    font-size: 0.72rem;
    color: var(--muted-foreground);
  }

  .shortcut-chip kbd {
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    background: var(--sand);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    color: var(--foreground);
  }

  /* WhatsApp Pill */
  .whatsapp-mini-preview {
    margin-top: 0.35rem;
  }

  .whatsapp-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #bbf7d0;
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .modal-bottom {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.5rem;
  }
</style>

<script>
  // Dynamic Pricing Switcher exact to Lovable TSX
  const brl = (v) =>
    v.toLocaleString("pt-BR", { style: "currency", currency: "BRL", minimumFractionDigits: 0 });

  function priceFor(monthly, cycle) {
    if (cycle === "free") return { main: "Grátis", sub: "7 dias ou até 20 atendimentos" };
    if (cycle === "trimestral")
      return {
        main: `${brl(monthly * 0.9)}/mês`,
        sub: `Total ${brl(monthly * 0.9 * 3)} por trimestre`,
      };
    if (cycle === "anual")
      return {
        main: `${brl(monthly * 0.75)}/mês`,
        sub: `Total ${brl(monthly * 0.75 * 12)} por ano`,
      };
    return { main: `${brl(monthly)}/mês`, sub: "Cancele quando quiser" };
  }

  function setupPricing() {
    const cycleButtons = document.querySelectorAll(".cycle-btn");
    const cards = document.querySelectorAll(".plan-card");

    function setCycle(cycleId) {
      cycleButtons.forEach(btn => {
        btn.classList.toggle("active", btn.getAttribute("data-cycle") === cycleId);
      });

      cards.forEach(card => {
        const monthly = parseFloat(card.getAttribute("data-monthly") || "0");
        const price = priceFor(monthly, cycleId);
        
        const mainEl = card.querySelector("[data-price-main]");
        const subEl = card.querySelector("[data-price-sub]");
        const ctaBtn = card.querySelector(".plan-cta-btn");

        if (mainEl) mainEl.textContent = price.main;
        if (subEl) subEl.textContent = price.sub;
        if (ctaBtn) {
          ctaBtn.textContent = cycleId === "free" ? "Ativar degustação" : (ctaBtn.getAttribute("data-cta-default") || "Contratar");
        }
      });
    }

    cycleButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        const c = btn.getAttribute("data-cycle");
        if (c) setCycle(c);
      });
    });
  }

  // Modal open/close logic
  function setupModal() {
    const overlay = document.getElementById("featuresModalOverlay");
    const openBtn = document.getElementById("btnOpenFeaturesModal");
    const closeBtn = document.getElementById("btnCloseFeaturesModal");
    const ctaBtn = document.getElementById("modalCtaPlanos");

    function open() {
      overlay?.classList.add("is-active");
      document.body.style.overflow = "hidden";
    }

    function close() {
      overlay?.classList.remove("is-active");
      document.body.style.overflow = "";
    }

    openBtn?.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);
    ctaBtn?.addEventListener("click", close);

    overlay?.addEventListener("click", (e) => {
      if (e.target === overlay) close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay?.classList.contains("is-active")) {
        close();
      }
    });
  }

  // Alternador com setas entre as 3 Versões da Seção 2
  function setupPlatformToggle() {
    const btnPrev = document.getElementById("btnPrevPlatformMode");
    const btnNext = document.getElementById("btnNextPlatformMode");
    const modeCounter = document.getElementById("platformModeCounter");
    const modeLabel = document.getElementById("platformModeLabel");

    const v1 = document.getElementById("platformViewV1");
    const v2 = document.getElementById("platformViewV2");
    const v3 = document.getElementById("platformViewV3");

    const imgV1 = document.getElementById("platformImgV1");
    const imgV3 = document.getElementById("platformImgV3");

    if (!btnPrev || !btnNext || !v1 || !v2 || !v3) return;

    const versions = [
      {
        id: 1,
        title: "Opção 1: Pesquisas + Foto Vertical",
        view: v1,
        showImgV1: true,
      },
      {
        id: 2,
        title: "Opção 2: Imagem Dedicada por Pesquisa",
        view: v2,
        showImgV1: false,
      },
      {
        id: 3,
        title: "Opção 3: Minimalista Original",
        view: v3,
        showImgV1: false,
      }
    ];

    let currentIndex = 0;

    function applyVersion(index) {
      currentIndex = (index + versions.length) % versions.length;
      const current = versions[currentIndex];

      if (modeCounter) modeCounter.textContent = `${current.id}/3`;
      if (modeLabel) modeLabel.textContent = current.title;

      versions.forEach((v, i) => {
        if (i === currentIndex) {
          v.view.classList.add("active");
        } else {
          v.view.classList.remove("active");
        }
      });

      const sectionEl = document.getElementById("plataforma");
      if (sectionEl) {
        sectionEl.classList.toggle("mode-v2-active", current.id === 2);
      }

      if (imgV1 && imgV3) {
        if (current.showImgV1) {
          imgV1.classList.add("active");
          imgV3.classList.remove("active");
        } else {
          imgV1.classList.remove("active");
          imgV3.classList.add("active");
        }
      }
    }

    btnNext.addEventListener("click", () => applyVersion(currentIndex + 1));
    btnPrev.addEventListener("click", () => applyVersion(currentIndex - 1));

    // Suporte a gestos touch para swipe lateral no mobile
    const sectionEl = document.getElementById("plataforma");
    if (sectionEl) {
      let touchStartX = 0;
      let touchStartY = 0;
      let touchStartTime = 0;

      sectionEl.addEventListener("touchstart", (e) => {
        if (e.touches.length === 1) {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          touchStartTime = Date.now();
        }
      }, { passive: true });

      sectionEl.addEventListener("touchend", (e) => {
        if (e.changedTouches.length === 1) {
          const deltaX = e.changedTouches[0].clientX - touchStartX;
          const deltaY = e.changedTouches[0].clientY - touchStartY;
          const elapsedTime = Date.now() - touchStartTime;

          // Se for um deslize prioritariamente horizontal de pelo menos 40px em menos de 800ms
          if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY) * 1.2 && elapsedTime < 800) {
            if (deltaX < 0) {
              // Deslizou para a esquerda -> próxima versão
              applyVersion(currentIndex + 1);
            } else {
              // Deslizou para a direita -> versão anterior
              applyVersion(currentIndex - 1);
            }
          }
        }
      }, { passive: true });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      setupPricing();
      setupModal();
      setupPlatformToggle();
    });
  } else {
    setupPricing();
    setupModal();
    setupPlatformToggle();
  }
</script>
