    padding-inline: 1.25rem !important;
  }

  /* 1 — Hero */
  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.2rem, 3.2vmin, 2.2rem);
    padding-inline: max(1.5rem, 8vmin);
    padding-top: 4.5rem;
    text-align: center;
  }

  .hero-brand-top {
    display: flex;
    flex-direction: column;
