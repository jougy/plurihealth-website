---
---

<section class="viewport-section pricing-viewport-section" id="planos">
  <div class="pricing-container">
    
    <!-- Header -->
    <div class="pricing-header">
      <h2 class="pricing-title">
        Escolha seu plano.
      </h2>
      <p class="pricing-subtitle">
        Sem taxas escondidas. Cancele quando quiser.
      </p>

      <!-- Period Billing Switcher -->
      <div class="billing-switcher-pills" role="tablist" aria-label="Seletor de Frequência de Pagamento">
        <button type="button" class="pill-btn" data-billing="trial">
          Degustação grátis
        </button>
        <button type="button" class="pill-btn active" data-billing="monthly">
          Mensal
        </button>
        <button type="button" class="pill-btn" data-billing="quarterly">
          Trimestral <span class="discount-badge">-10%</span>
        </button>
        <button type="button" class="pill-btn" data-billing="annual">
          Anual <span class="discount-badge">-25%</span>
        </button>
      </div>
    </div>

    <!-- 3 Pricing Cards Grid -->
    <div class="pricing-cards-grid">
      
      <!-- Card 1: Profissional Solo -->
      <div class="plan-box" id="plan-solo">
        <div class="plan-box-top">
          <div class="plan-name-wrap">
            <h3 class="plan-name">Profissional Solo</h3>
            <span class="plan-sub">1 profissional de saúde</span>
          </div>

          <div class="plan-price-display">
            <div class="price-value-row">
              <span class="currency">R$</span>
              <span class="price-number" data-price-solo>59</span>
              <span class="billing-cycle">/mês</span>
            </div>
            <span class="cancel-note">Cancele quando quiser</span>
          </div>
        </div>

        <ul class="plan-checklist">
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>1 acesso simultâneo individual</span>
          </li>
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Atendimentos e pacientes ilimitados</span>
          </li>
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Prontuário eletrônico e anamnese</span>
          </li>
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Agenda e controle financeiro</span>
          </li>
        </ul>

        <div class="plan-cta-wrap">
          <a href="https://pluri.health/planos" target="_blank" rel="noopener" class="btn btn-pill btn-pill-dark w-full">
            Contratar Solo
          </a>
        </div>
      </div>

      <!-- Card 2: Clínica Pro (Recomendado) -->
      <div class="plan-box plan-box-highlight" id="plan-clinic">
        <div class="recommended-badge">Recomendado</div>

        <div class="plan-box-top">
          <div class="plan-name-wrap">
            <h3 class="plan-name">Clínica Pro</h3>
            <span class="plan-sub">Equipes e consultórios · base 4 assentos</span>
          </div>

          <div class="plan-price-display">
            <div class="price-value-row">
              <span class="currency">R$</span>
              <span class="price-number" data-price-pro>139</span>
              <span class="billing-cycle">/mês</span>
            </div>
            <span class="cancel-note">Cancele quando quiser</span>
          </div>
        </div>

        <ul class="plan-checklist">
          <li>
            <svg class="check-icon check-featured" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span><strong>4 acessos simultâneos inclusos</strong></span>
          </li>
          <li>
            <svg class="check-icon check-featured" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Colaboradores ilimitados (30 vagas)</span>
          </li>
          <li>
            <svg class="check-icon check-featured" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Permissões avançadas (RBAC)</span>
          </li>
          <li>
            <svg class="check-icon check-featured" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Agendas compartilhadas e relatórios</span>
          </li>
        </ul>

        <div class="plan-cta-wrap">
          <a href="https://pluri.health/planos" target="_blank" rel="noopener" class="btn btn-pill btn-pill-apple w-full">
            Contratar Clínica Pro
          </a>
        </div>
      </div>

      <!-- Card 3: Enterprise -->
      <div class="plan-box" id="plan-enterprise">
        <div class="plan-box-top">
          <div class="plan-name-wrap">
            <h3 class="plan-name">Enterprise</h3>
            <span class="plan-sub">Alta escala · base 10 assentos</span>
          </div>

          <div class="plan-price-display">
            <div class="price-value-row">
              <span class="currency">R$</span>
              <span class="price-number" data-price-ent>299</span>
              <span class="billing-cycle">/mês</span>
            </div>
            <span class="cancel-note">Cancele quando quiser</span>
          </div>
        </div>

        <ul class="plan-checklist">
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>10 acessos simultâneos inclusos</span>
          </li>
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Até 100 profissionais cadastrados</span>
          </li>
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Assentos extras por R$ 15/mês (-40%)</span>
          </li>
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Múltiplas unidades e auditoria</span>
          </li>
        </ul>

        <div class="plan-cta-wrap">
          <a href="https://pluri.health/planos" target="_blank" rel="noopener" class="btn btn-pill btn-pill-dark w-full">
            Contratar Enterprise
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Footer Trust Strip -->
    <div class="pricing-trust-strip">
      <span>Pagamento no PIX com 5% de desconto</span>
      <span class="sep">•</span>
      <span>Cancele quando quiser</span>
      <span class="sep">•</span>
      <span>Pluri Health</span>
    </div>

  </div>
</section>

<style>
  .pricing-viewport-section {
    background-color: #f8fafc;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4.5rem, 8vh, 6rem) clamp(1.5rem, 4vw, 3.5rem);
    position: relative;
    overflow: hidden;
  }

  .pricing-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pricing-header {
    text-align: center;
    max-width: 720px;
    margin-bottom: clamp(2rem, 4vh, 3.25rem);
  }

  .pricing-title {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }

  .pricing-subtitle {
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    color: #64748b;
    margin-bottom: 1.5rem;
  }

  /* Switcher */
  .billing-switcher-pills {
    display: inline-flex;
    align-items: center;
    background: #e2e8f0;
    padding: 0.35rem;
    border-radius: 9999px;
    gap: 0.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pill-btn {
    padding: 0.5rem 1.15rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #475569;
    border-radius: 9999px;
    border: none;
    background: transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: all 150ms ease;
  }

  .pill-btn:hover {
    color: #0f172a;
  }

  .pill-btn.active {
    background: #0f172a;
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.15);
  }

  .discount-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: #0284c7;
    background: #e0f2fe;
    padding: 0.1rem 0.4rem;
    border-radius: 9999px;
  }

  .pill-btn.active .discount-badge {
    color: #38bdf8;
    background: rgba(255, 255, 255, 0.15);
  }

  /* Grid */
  .pricing-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2vw, 2rem);
    width: 100%;
    margin-bottom: clamp(2rem, 4vh, 3rem);
  }

  .plan-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1.75rem;
    padding: clamp(1.75rem, 3vh, 2.25rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: left;
    box-shadow: 0 4px 12px -2px rgba(15, 23, 42, 0.04);
    position: relative;
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .plan-box:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -6px rgba(15, 23, 42, 0.08);
  }

  .plan-box-highlight {
    background: #eff6ff;
    border: 2px solid #0071e3;
    box-shadow: 0 12px 32px -4px rgba(0, 113, 227, 0.18);
  }

  .recommended-badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: #0071e3;
    color: #ffffff;
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    letter-spacing: 0.02em;
  }

  .plan-box-top {
    margin-bottom: 1.5rem;
  }

  .plan-name {
    font-family: 'Outfit', sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.25rem;
  }

  .plan-sub {
    font-size: 0.825rem;
    color: #64748b;
    display: block;
    margin-bottom: 1.25rem;
  }

  .price-value-row {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .currency {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
  }

  .price-number {
    font-family: 'Outfit', sans-serif;
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1;
    color: #0f172a;
  }

  .billing-cycle {
    font-size: 0.9rem;
    font-weight: 600;
    color: #64748b;
  }

  .cancel-note {
    font-size: 0.75rem;
    color: #94a3b8;
    display: block;
    margin-top: 0.35rem;
  }

  /* Checklist */
  .plan-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex: 1;
  }

  .plan-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.875rem;
    color: #334155;
    line-height: 1.4;
  }

  .check-icon {
    color: #0284c7;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .check-featured {
    color: #0071e3;
  }

  .w-full {
    width: 100%;
  }

  /* Trust Strip */
  .pricing-trust-strip {
    font-size: 0.8rem;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .pricing-trust-strip .sep {
    color: #cbd5e1;
  }

  @media (max-width: 960px) {
    .pricing-cards-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
    }
  }
</style>

<script>
  function setupPricingSwitcher() {
    const buttons = document.querySelectorAll('.billing-switcher-pills .pill-btn');
    const soloPrice = document.querySelector('[data-price-solo]');
    const proPrice = document.querySelector('[data-price-pro]');
    const entPrice = document.querySelector('[data-price-ent]');

    const prices = {
      trial: { solo: '0', pro: '0', ent: '0', note: '20 atendimentos grátis para sempre' },
      monthly: { solo: '59', pro: '139', ent: '299', note: 'Cancele quando quiser' },
      quarterly: { solo: '53', pro: '125', ent: '269', note: 'Cobrado a cada 3 meses (-10%)' },
      annual: { solo: '44', pro: '104', ent: '224', note: 'Cobrado anualmente (-25%)' }
    };

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const billing = btn.getAttribute('data-billing') || 'monthly';
        const data = prices[billing];

        if (soloPrice) soloPrice.textContent = data.solo;
        if (proPrice) proPrice.textContent = data.pro;
        if (entPrice) entPrice.textContent = data.ent;

        document.querySelectorAll('.cancel-note').forEach(noteEl => {
          noteEl.textContent = data.note;
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPricingSwitcher);
  } else {
    setupPricingSwitcher();
  }
</script>
