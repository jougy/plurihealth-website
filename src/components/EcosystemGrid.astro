---
---

<section class="viewport-section platform-viewport-section" id="plataforma">
  <div class="platform-container">
    
    <!-- Left Column: Typography & Conversion Copy -->
    <div class="platform-text-col">
      <div class="platform-badge-wrap">
        <span class="platform-tag">GESTÃO INTEGRADA</span>
      </div>
      
      <h2 class="platform-title">
        Toda a clínica. Um sistema.
      </h2>
      
      <p class="platform-lead">
        Prontuário, agenda e financeiro conversando entre si — sem planilhas, sem retrabalho.
      </p>

      <div class="platform-bullets">
        <div class="bullet-item">
          <span class="bullet-check">✓</span>
          <div>
            <strong>Abertura em menos de 50ms</strong>
            <p>IndexedDB local para você nunca esperar a tela carregar.</p>
          </div>
        </div>
        <div class="bullet-item">
          <span class="bullet-check">✓</span>
          <div>
            <strong>Auto-save contínuo em tempo real</strong>
            <p>Se a bateria acabar ou fechar o app, nada é perdido.</p>
          </div>
        </div>
      </div>

      <div class="platform-actions">
        <a href="#planos" class="btn btn-pill btn-pill-dark">
          <span>Ver planos</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <button 
          type="button" 
          class="btn-trigger-link" 
          data-open-feature-modal="zero-perda"
          title="Conheça a tecnologia de proteção contra perda de dados"
        >
          <span>🛡️ Por que é impossível perder anotações?</span>
        </button>
      </div>
    </div>

    <!-- Right Column: Realistic Blue Tablet Mockup -->
    <div class="platform-visual-col">
      <div class="tablet-mockup-wrapper">
        <img 
          src="/images/platform_tablet_blue.jpg" 
          alt="Painel Pluri Fisio exibido em um tablet com prontuário, escala EVA e agenda em tons de azul" 
          class="tablet-mockup-img"
          loading="lazy"
        />
        <!-- Ambient blue glow behind tablet -->
        <div class="mockup-glow" aria-hidden="true"></div>
      </div>
    </div>

  </div>
</section>

<style>
  .platform-viewport-section {
    background-color: #ffffff;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4.5rem, 8vh, 6rem) clamp(1.5rem, 5vw, 4.5rem);
    position: relative;
    overflow: hidden;
  }

  .platform-container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .platform-text-col {
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .platform-badge-wrap {
    margin-bottom: 1rem;
  }

  .platform-tag {
    font-size: 0.725rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #0284c7;
    background: #e0f2fe;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    display: inline-block;
  }

  .platform-title {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: #0f172a;
    margin-bottom: 1.25rem;
  }

  .platform-lead {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: #475569;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .platform-bullets {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    margin-bottom: 2.25rem;
  }

  .bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .bullet-check {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background-color: #e0f2fe;
    color: #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .bullet-item strong {
    display: block;
    font-size: 0.95rem;
    color: #0f172a;
    font-weight: 700;
  }

  .bullet-item p {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0;
    line-height: 1.4;
  }

  .platform-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-trigger-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: #0284c7;
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 4px;
    padding: 0.4rem 0;
    transition: color 150ms ease;
  }

  .btn-trigger-link:hover {
    color: #0369a1;
  }

  /* Tablet Visual Col */
  .platform-visual-col {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tablet-mockup-wrapper {
    position: relative;
    width: 100%;
    max-width: 680px;
    border-radius: 1.75rem;
    overflow: hidden;
    box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.18), 0 10px 25px -5px rgba(2, 132, 199, 0.08);
    transition: transform 300ms ease, box-shadow 300ms ease;
  }

  .tablet-mockup-wrapper:hover {
    transform: translateY(-4px);
    box-shadow: 0 35px 70px -15px rgba(15, 23, 42, 0.22);
  }

  .tablet-mockup-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .mockup-glow {
    position: absolute;
    inset: 10%;
    background: radial-gradient(circle, rgba(2, 132, 199, 0.15) 0%, transparent 70%);
    filter: blur(40px);
    z-index: -1;
    pointer-events: none;
  }

  @media (max-width: 960px) {
    .platform-container {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .platform-text-col {
      align-items: center;
      text-align: center;
    }
    .platform-lead {
      max-width: 580px;
    }
    .platform-bullets {
      align-items: flex-start;
      text-align: left;
      max-width: 480px;
    }
    .platform-actions {
      justify-content: center;
    }
    .tablet-mockup-wrapper {
      max-width: 520px;
      margin-top: 1rem;
    }
  }
</style>
