---
import SectionHeader from './ui/SectionHeader.astro';
---

<section class="clinical-section" id="recursos">
  <div class="container">
    
    <!-- Section Header -->
    <SectionHeader
      badgeText="Tudo no Celular ou Computador"
      badgeVariant="sage"
      title="Tudo o que seu consultório precisa, simples de usar no dia a dia"
      subtitle="Criado para quem não tem tempo a perder com sistemas complicados. Tudo intuitivo, com telas limpas e na palma da sua mão."
    />

    <!-- 4 Pillars 2x2 Grid -->
    <div class="features-grid">
      
      <!-- Pillar 1: Custom Medical Records & Anamnesis -->
      <div class="feature-card">
        <div class="feature-icon-wrapper text-teal">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>

        <div class="feature-content">
          <div class="feature-tag text-teal">Fichas & Anamnese Personalizada</div>
          <h3 class="feature-title">Fichas Prontas e Personalizáveis com Poucos Toques</h3>
          <p class="feature-desc">
            Use modelos prontos da nossa biblioteca ou monte suas fichas com campos de texto, múltipla escolha, checklists e tags coloridas para registrar a evolução em menos de 90 segundos.
          </p>

          <ul class="feature-checklist">
            <li>
              <span class="check-icon">✓</span>
              <span>Modelos prontos de anamnese e fichas de evolução para fisioterapia</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span>Editor visual com tags coloridas por especialidade e sintomas</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span>Linha do tempo cronológica com histórico completo das queixas</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Pillar 2: Pre-Registration via WhatsApp & Scheduling -->
      <div class="feature-card">
        <div class="feature-icon-wrapper text-sage">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
        </div>

        <div class="feature-content">
          <div class="feature-tag text-sage">Pré-Cadastro & WhatsApp</div>
          <h3 class="feature-title">Pré-Cadastro no Celular do Paciente & Agenda</h3>
          <p class="feature-desc">
            Envie um link seguro em 1 clique no WhatsApp para o paciente preencher o próprio cadastro antes de chegar à clínica, protegido pelos dígitos do CPF dele.
          </p>

          <ul class="feature-checklist">
            <li>
              <span class="check-icon">✓</span>
              <span>Link de pré-cadastro seguro compartilhado direto pelo WhatsApp</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span>Proteção com senha: o paciente desbloqueia digitando o CPF</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span>Agenda com marcação visual dos dias da semana (D S T Q Q S S) e salas</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Pillar 3: Financial & Session Packages -->
      <div class="feature-card">
        <div class="feature-icon-wrapper text-amber">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <line x1="2" y1="10" x2="22" y2="10"></line>
            <path d="M6 15h2"></path>
            <path d="M12 15h6"></path>
          </svg>
        </div>

        <div class="feature-content">
          <div class="feature-tag text-amber">Financeiro & Pacotes</div>
          <h3 class="feature-title">Controle de Pacotes de Sessões e Pagamentos</h3>
          <p class="feature-desc">
            Controle visual do saldo de sessões dos pacientes (ex: 4 de 8 sessões realizadas), acompanhamento de recebimentos no PIX e emissão de recibos.
          </p>

          <ul class="feature-checklist">
            <li>
              <span class="check-icon">✓</span>
              <span>Controle automático de sessões restantes em pacotes de tratamento</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span>Emissão rápida de recibos para pedidos de reembolso em convênios</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span>Relatório do faturamento do mês e atendimentos em dia</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Pillar 4: Team & Access Control -->
      <div class="feature-card">
        <div class="feature-icon-wrapper text-purple">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>

        <div class="feature-content">
          <div class="feature-tag text-purple">Equipe & Permissões</div>
          <h3 class="feature-title">Convites Fáceis e Controle para a Equipe</h3>
          <p class="feature-desc">
            Convide fisioterapeutas, recepcionistas e estagiários em segundos por e-mail ou link e defina com facilidade o que cada pessoa pode ver ou editar.
          </p>

          <ul class="feature-checklist">
            <li>
              <span class="check-icon">✓</span>
              <span>Convite rápido com link para novos profissionais entrarem na clínica</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span>Perfis definidos: Proprietário, Fisioterapeuta, Recepção e Estágio</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span>Cofre digital seguro na nuvem com sigilo total e conformidade LGPD</span>
            </li>
          </ul>
        </div>
      </div>

    </div>

    <!-- Community Co-Creation Banner -->
    <div class="community-banner">
      <div class="community-banner-header">
        <h4 class="community-title">Desenvolvido Junto com Quem Atende Todos os Dias</h4>
        <p class="community-desc">
          O Pluri Health não é um sistema difícil criado por quem nunca entrou num consultório. Melhoramos o sistema toda semana ouvindo nossos usuários.
        </p>
      </div>

      <div class="community-cards-grid">
        <div class="feedback-card">
          <div class="feedback-badge text-teal">Pedido Atendido</div>
          <p class="feedback-quote">"Quero que o paciente preencha o cadastro antes da consulta para não perder tempo na recepção."</p>
          <div class="feedback-result">➔ Solução: Link de pré-cadastro seguro enviado pelo WhatsApp protegido com senha.</div>
        </div>

        <div class="feedback-card">
          <div class="feedback-badge text-sage">Pedido Atendido</div>
          <p class="feedback-quote">"Preciso convidar outros terapeutas e definir quem pode ver o financeiro."</p>
          <div class="feedback-result">➔ Solução: Gestão de equipe com convites por link e controle de permissões em 1 clique.</div>
        </div>

        <div class="feedback-card">
          <div class="feedback-badge text-amber">Pedido Atendido</div>
          <p class="feedback-quote">"Tenho medo de não saber passar minhas fichas de papel para o sistema."</p>
          <div class="feedback-result">➔ Solução: Nossa equipe passa todas as suas fichas antigas de graça para você.</div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 4.5rem;
  }

  .feature-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: 2.25rem;
    box-shadow: var(--shadow-card);
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
  }

  .feature-card:hover {
    border-color: var(--color-primary-border);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .feature-icon-wrapper {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-md);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .feature-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .feature-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.25;
  }

  .feature-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .feature-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.875rem;
    color: var(--text-primary);
  }

  .feature-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    line-height: 1.45;
  }

  .check-icon {
    color: var(--color-sage);
    font-weight: 800;
    flex-shrink: 0;
  }

  .text-teal { color: var(--color-primary); }
  .text-sage { color: var(--color-sage); }
  .text-amber { color: var(--color-amber); }
  .text-purple { color: var(--color-purple); }

  /* Community Banner */
  .community-banner {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: 2.75rem 2.25rem;
  }

  .community-banner-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2rem auto;
  }

  .community-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .community-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .community-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .feedback-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .feedback-badge {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .feedback-quote {
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-style: italic;
    line-height: 1.5;
  }

  .feedback-result {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-light);
  }

  @media (max-width: 960px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
    .community-cards-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .feature-card {
      flex-direction: column;
      padding: 1.75rem 1.5rem;
    }
  }
</style>
