---
---

<section class="viewport-section hero-viewport-section" id="lancamento">
  <!-- Subtle concentric background circles -->
  <div class="hero-radar-circles" aria-hidden="true">
    <div class="circle circle-1"></div>
    <div class="circle circle-2"></div>
    <div class="circle circle-3"></div>
    <div class="grid-overlay"></div>
  </div>

  <div class="hero-center-box">
    <!-- Eyebrow Badge -->
    <div class="hero-badge-wrap">
      <span class="hero-tag">LANÇAMENTO OFICIAL</span>
    </div>

    <!-- Giant Apple/Lovable Headline -->
    <h1 class="hero-title">
      Pluri Fisio.
    </h1>

    <!-- Minimal 2-Sentence Subhead -->
    <p class="hero-subtitle">
      A prática da fisioterapia, inteira em uma tela. Evolução, agenda e pacotes de sessões.
    </p>

    <!-- Dual Pill Buttons (Apple / Lovable) -->
    <div class="hero-actions">
      <a href="#planos" class="btn btn-pill btn-pill-apple hero-cta-btn">
        <span>Começar grátis</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <button 
        type="button" 
        class="btn btn-pill btn-pill-dark hero-learn-btn" 
        data-open-feature-modal="thumb-zone"
        title="Veja como funciona o atendimento ao lado da maca"
      >
        <span>Ver como funciona na maca</span>
      </button>
    </div>

    <!-- Micro-trust note -->
    <div class="hero-trust">
      <span>20 atendimentos grátis</span>
      <span class="sep">•</span>
      <span>Sem cartão de crédito</span>
      <span class="sep">•</span>
      <span>Auto-save em tempo real</span>
    </div>
  </div>
</section>

<style>
  .hero-viewport-section {
    position: relative;
    background-color: #f8fafc;
    background: radial-gradient(circle at 50% 50%, #eff6ff 0%, #f8fafc 70%, #f1f5f9 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100dvh;
    padding-top: 3.5rem;
    overflow: hidden;
  }

  /* Concentric decorative circles */
  .hero-radar-circles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.65;
  }

  .circle {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(2, 132, 199, 0.12);
  }

  .circle-1 {
    width: min(500px, 80vw);
    height: min(500px, 80vw);
  }

  .circle-2 {
    width: min(780px, 120vw);
    height: min(780px, 120vw);
  }

  .circle-3 {
    width: min(1080px, 160vw);
    height: min(1080px, 160vw);
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, rgba(2, 132, 199, 0.04) 1px, transparent 1px),
                      linear-gradient(to bottom, rgba(2, 132, 199, 0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(circle at 50% 50%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 30%, transparent 75%);
  }

  .hero-center-box {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .hero-badge-wrap {
    margin-bottom: 1.25rem;
  }

  .hero-tag {
    display: inline-block;
    font-size: 0.725rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0284c7;
    background-color: #e0f2fe;
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
  }

  .hero-title {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(3rem, 7vw, 5.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: #0f172a;
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    color: #475569;
    max-width: 580px;
    margin: 0 auto 2.25rem auto;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .hero-cta-btn {
    font-size: 0.95rem;
    padding: 0.75rem 1.75rem;
    background-color: #0071e3;
    border-color: #0071e3;
  }

  .hero-cta-btn:hover {
    background-color: #0077ed;
  }

  .hero-learn-btn {
    font-size: 0.95rem;
    padding: 0.75rem 1.6rem;
    background-color: #0f172a;
    border-color: #0f172a;
  }

  .hero-learn-btn:hover {
    background-color: #1e293b;
  }

  .hero-trust {
    font-size: 0.8rem;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .hero-trust .sep {
    color: #cbd5e1;
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
      gap: 0.75rem;
    }
    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
