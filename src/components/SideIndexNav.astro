---
interface NavItem {
  id: string;
  label: string;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<aside class="side-index-nav" aria-label="Navegação lateral de seções">
  <ul class="side-nav-list">
    {items.map((item, index) => (
      <li class="side-nav-item">
        <a 
          href={`#${item.id}`} 
          class={`side-nav-link ${index === 0 ? 'active' : ''}`}
          data-target={item.id}
          aria-label={`Navegar para seção ${item.label}`}
        >
          <span class="side-nav-label">{item.label}</span>
          <span class="side-nav-dot" aria-hidden="true">
            <span class="side-nav-dot-inner"></span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</aside>

<style>
  .side-index-nav {
    position: fixed;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 90;
    pointer-events: none;
  }

  .side-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    align-items: flex-end;
    pointer-events: auto;
  }

  .side-nav-item {
    display: flex;
    align-items: center;
  }

  .side-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    cursor: pointer;
    group: relative;
    transition: all 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .side-nav-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-primary);
    opacity: 0.35;
    transition: all 250ms ease;
    transform: translateX(4px);
    user-select: none;
  }

  .side-nav-dot {
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .side-nav-dot-inner {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--text-primary);
    opacity: 0.35;
    transition: all 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hover state */
  .side-nav-link:hover .side-nav-label {
    opacity: 0.8;
    transform: translateX(0);
  }

  .side-nav-link:hover .side-nav-dot-inner {
    opacity: 0.8;
    transform: scale(1.3);
  }

  /* Active state (Inspired by wil4it.com) */
  .side-nav-link.active .side-nav-label {
    opacity: 1;
    font-size: 0.8rem;
    font-weight: 800;
    transform: translateX(0);
  }

  .side-nav-link.active .side-nav-dot {
    border-radius: 50%;
    background-color: rgba(20, 21, 23, 0.08);
    box-shadow: 0 0 0 4px rgba(20, 21, 23, 0.06);
  }

  .side-nav-link.active .side-nav-dot-inner {
    opacity: 1;
    width: 8px;
    height: 8px;
    background-color: var(--text-primary);
    transform: scale(1);
  }

  @media (max-width: 1100px) {
    .side-index-nav {
      right: 1rem;
    }
    .side-nav-label {
      display: none;
    }
    .side-nav-link.active .side-nav-dot {
      background-color: rgba(20, 21, 23, 0.12);
    }
  }

  @media (max-width: 640px) {
    .side-index-nav {
      display: none;
    }
  }
</style>

<script>
  function setupSideNav() {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.side-nav-link');
    if (!navLinks.length) return;

    const sections = Array.from(navLinks)
      .map(link => {
        const id = link.getAttribute('data-target');
        return id ? document.getElementById(id) : null;
      })
      .filter((sec): sec is HTMLElement => sec !== null);

    if (!sections.length) return;

    // Smooth click handler
    navLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('data-target');
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // IntersectionObserver to sync active link on scroll
    const observerOptions = {
      root: null,
      rootMargin: '-30% 0px -30% 0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach(link => {
            if (link.getAttribute('data-target') === id) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));
  }

  // Setup on page load & Astro page transitions if any
  document.addEventListener('DOMContentLoaded', setupSideNav);
  document.addEventListener('astro:page-load', setupSideNav);
</script>
