---
// HeaderNav.astro - Navegação fixa com logo e atalhos de seção
---

<header class="lovable-header">
  <nav aria-label="Principal" class="header-nav">
    <a href="#institucional" class="t-small brand-logo">
      <img
        src="/branding/logo/pluri_health_icon_gradient.svg"
        alt="Pluri Health"
        class="brand-icon"
        width="28"
        height="28"
      />
      <span>Pluri&nbsp;<strong>Health</strong></span>
    </a>
    <ul class="nav-links">
      <li>
        <a href="#gestao-clinica" class="t-small nav-link">
          Gestão de Clínicas
        </a>
      </li>
      <li>
        <a href="#pluri-fisio" class="t-small nav-link nav-highlight">
          Lançamento Pluri Fisio
        </a>
      </li>
      <li>
        <a href="#ecossistema" class="t-small nav-link">
          Ecossistema
        </a>
      </li>
    </ul>
    <div class="header-actions-group">
      <a 
        href="https://plurifisio.com.br" 
        target="_blank" 
        rel="noopener" 
        class="btn-clay t-small header-btn header-btn-fisio"
        title="Acessar o sistema Pluri Fisio em plurifisio.com.br"
      >
        <span>Acessar Pluri Fisio</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>
  </nav>
</header>

<style>
  .lovable-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    background-color: rgba(251, 250, 248, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-nav {
    margin-inline: auto;
    display: flex;
    height: 3.5rem;
    width: 100%;
    max-width: 1600px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: max(1rem, 3vw);
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--foreground);
    text-decoration: none;
  }

  .brand-icon {
    width: clamp(22px, 3.2vmin, 26px);
    height: auto;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(0, 114, 255, 0.25));
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: max(1rem, 2vw);
    list-style: none;
  }

  @media (min-width: 640px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-link {
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--foreground);
  }

  .nav-highlight {
    color: var(--clay);
    font-weight: 600;
  }

  .header-actions-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-btn {
    min-height: 2.25rem !important;
    padding-inline: 1.25rem !important;
  }

  .header-btn-fisio {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    box-shadow: 0 4px 14px rgba(0, 114, 255, 0.2);
  }
</style>
