---
// WorkflowSection.astro - Seção 3: Como Funciona (6 Etapas com Tipografia Acessível)
---

<section
  id="como-funciona"
  aria-labelledby="como-titulo"
  class="snap-page how-section"
>
  <div class="how-header-row">
    <h2 id="como-titulo" class="t-title how-title">
      Seis etapas. Nenhuma fricção.
    </h2>
    <button type="button" class="btn-features-trigger" id="btnOpenFeaturesModal">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
      </svg>
      <span>Conheça as principais funcionalidades</span>
    </button>
  </div>

  <ol class="how-steps-grid">
    <!-- Passo 1: Auto-cadastro -->
    <li class="how-step-item">
      <div class="how-step-top-line">
        <div class="how-step-icon">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="8.5" cy="7" r="4"></circle>
            <line x1="20" y1="8" x2="20" y2="14"></line>
            <line x1="23" y1="11" x2="17" y2="11"></line>
          </svg>
        </div>
        <span class="step-num">01</span>
      </div>
      <h3 class="step-title">
        Auto-cadastro
      </h3>
      <p class="step-desc">
        O paciente preenche a ficha no celular antes de chegar, poupando tempo na maca.
      </p>
    </li>

    <!-- Passo 2: Agenda Inteligente -->
    <li class="how-step-item">
      <div class="how-step-top-line">
        <div class="how-step-icon">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <span class="step-num">02</span>
      </div>
      <h3 class="step-title">
        Agenda Ágil
      </h3>
      <p class="step-desc">
        Marcação rápida com visão clara de quem chegou, aguarda ou está em atraso.
      </p>
    </li>

    <!-- Passo 3: Anamnese Customizada -->
    <li class="how-step-item">
      <div class="how-step-top-line">
        <div class="how-step-icon">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
        </div>
        <span class="step-num">03</span>
      </div>
      <h3 class="step-title">
        Anamnese Sob Medida
      </h3>
      <p class="step-desc">
        Crie formulários no editor no-code ou use modelos prontos da nossa biblioteca.
      </p>
    </li>

    <!-- Passo 4: Tratamento Facilitado -->
    <li class="how-step-item">
      <div class="how-step-top-line">
        <div class="how-step-icon">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        </div>
        <span class="step-num">04</span>
      </div>
      <h3 class="step-title">
        Tratamento Facilitado
      </h3>
      <p class="step-desc">
        Prescreva condutas, exercícios e ciclos terapêuticos de forma ágil ao lado da maca.
      </p>
    </li>

    <!-- Passo 5: Pagamentos & Planos -->
    <li class="how-step-item">
      <div class="how-step-top-line">
        <div class="how-step-icon">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
        </div>
        <span class="step-num">05</span>
      </div>
      <h3 class="step-title">
        Pagamentos & Planos
      </h3>
      <p class="step-desc">
        Sessões avulsas, pacotes com dedução automática e controle financeiro em dia.
      </p>
    </li>

    <!-- Passo 6: Evolução & Estatísticas -->
    <li class="how-step-item">
      <div class="how-step-top-line">
        <div class="how-step-icon">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
            <polyline points="17 6 23 6 23 12"></polyline>
          </svg>
        </div>
        <span class="step-num">06</span>
      </div>
      <h3 class="step-title">
        Evolução & Métricas
      </h3>
      <p class="step-desc">
        Evolua em 60s puxando a última sessão e acompanhe a linha do tempo e estatísticas.
      </p>
    </li>
  </ol>
</section>

<style>
  .how-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 3vmin, 2.5rem);
    background-color: var(--ink);
    padding-inline: max(1.5rem, 6vmin);
    padding-top: clamp(4rem, 6vmin, 5rem);
    padding-bottom: clamp(1.5rem, 3vmin, 2.5rem);
    color: var(--bone);
  }

  .how-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .how-title {
    max-width: 18ch;
    color: var(--bone);
    font-size: clamp(2.2rem, 5.5vmin, 3.8rem);
    line-height: 1.08;
  }

  .btn-features-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(255, 255, 255, 0.12);
    color: var(--bone);
    border: 1px solid rgba(255, 255, 255, 0.28);
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-size: clamp(0.85rem, 1.6vmin, 1rem);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-features-trigger:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .how-steps-grid {
    display: grid;
    gap: clamp(1.2rem, 2.4vmin, 2rem);
    list-style: none;
    grid-template-columns: 1fr;
    padding: 0;
  }

  @media (min-width: 640px) {
    .how-steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .how-steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .how-step-item {
    border-top: 1px solid rgba(251, 250, 248, 0.22);
    padding-top: clamp(0.9rem, 1.8vmin, 1.4rem);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .how-step-item:hover {
    border-color: rgba(255, 255, 255, 0.55);
    transform: translateY(-2px);
  }

  .how-step-top-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }

  .how-step-icon {
    color: var(--clay);
    background: rgba(0, 114, 255, 0.15);
    padding: 0.5rem;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .step-num {
    opacity: 0.5;
    font-size: clamp(0.82rem, 1.5vmin, 0.95rem);
    font-family: ui-monospace, monospace;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .step-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.18rem, 2.2vmin, 1.55rem);
    color: var(--bone);
    margin-top: 0.2rem;
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  .step-desc {
    font-family: var(--font-accessible);
    font-weight: 400;
    letter-spacing: 0.015em;
    word-spacing: 0.05em;
    opacity: 0.95;
    line-height: 1.62;
    font-size: clamp(1rem, 1.85vmin, 1.25rem);
    color: var(--bone);
    max-width: 38ch;
  }

  /* Ajustes Mobile específicos para a Seção 3 (#como-funciona) */
  @media (max-width: 768px) {
    .how-section {
      height: 100svh !important;
      height: 100dvh !important;
      min-height: 100svh;
      max-height: 100svh;
      padding-top: 3.75rem !important;
      padding-bottom: 0.75rem !important;
      padding-inline: 1rem !important;
      justify-content: flex-start !important;
      gap: 0.6rem !important;
      overflow: hidden !important;
    }

    .how-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
      flex-shrink: 0;
    }

    .how-title {
      font-size: 1.55rem !important;
      line-height: 1.15;
    }

    .btn-features-trigger {
      padding: 0.45rem 0.9rem;
      font-size: 0.78rem;
      gap: 0.4rem;
    }

    .btn-features-trigger svg {
      width: 15px;
      height: 15px;
    }

    .how-steps-grid {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      flex: 1;
      padding-bottom: 1rem;
      padding-right: 0.25rem;
    }

    .how-step-item {
      padding-top: 0.65rem;
      gap: 0.2rem;
    }

    .how-step-icon {
      padding: 0.35rem;
      border-radius: 8px;
    }

    .how-step-icon svg {
      width: 18px;
      height: 18px;
    }

    .step-title {
      font-size: 1.1rem;
      margin-top: 0.1rem;
      margin-bottom: 0.15rem;
    }

    .step-desc {
      font-size: 0.88rem;
      line-height: 1.4;
      opacity: 0.9;
    }
  }
</style>
