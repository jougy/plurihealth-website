---
// PlatformSection.astro - Seção 2: Gestão de Clínicas — O motor inteligente da Pluri Health
---

<section
  id="gestao-clinica"
  aria-labelledby="gestao-clinica-titulo"
  class="snap-page platform-section-clean"
>
  <!-- Fundo com atmosfera clean azulada da marca -->
  <div class="platform-bg-branding" aria-hidden="true">
    <div class="platform-radial-glow"></div>
  </div>

  <div class="platform-card-wrap">
    
    <!-- Lado Esquerdo: Conteúdo Textual com Posicionamento em Gestão de Clínicas -->
    <div class="platform-text-column">
      <div class="platform-tag-pill">
        <span class="dot-indicator"></span>
        <span>GESTÃO INTELIGENTE DE CLÍNICAS</span>
      </div>

      <!-- Frase Principal Institucional -->
      <h2 id="gestao-clinica-titulo" class="platform-statement">
        A Pluri Health <strong>organiza sua clínica</strong>, conecta a rotina da <strong>sua equipe multiprofissional</strong> e elimina a fricção dos <strong>agendamentos e prontuários</strong>.
      </h2>

      <!-- Conclusão -->
      <p class="platform-punchline">
        Tecnologia pensada para consultórios e clínicas que buscam máxima agilidade e zero burocracia.
      </p>

      <!-- 3 Pílulas Essenciais da Solução para Clínicas -->
      <div class="platform-pillars-row">
        <div class="pillar-pill">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
          <span>Gestão Multiprofissional</span>
        </div>

        <div class="pillar-pill">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
          <span>Atendimento em Segundos</span>
        </div>

        <div class="pillar-pill">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>100% Seguro & LGPD</span>
        </div>
      </div>
    </div>

    <!-- Lado Direito: Ilustração Institucional Clínica -->
    <div class="platform-image-column">
      <div class="character-illustration-frame">
        <img
          src="/branding/illustrations/fisio_female_character.jpg"
          alt="Profissional gerenciando agendamentos e atendimentos com agilidade na clínica"
          class="character-image"
          width="400"
          height="400"
          loading="lazy"
        />
        <div class="character-caption-badge">
          <span class="badge-status-dot"></span>
          <span>Gestão integrada & sem atrito</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .platform-section-clean {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 100svh;
    max-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F8FAFC;
    padding: clamp(1rem, 3.5vh, 2.5rem) 1.5rem;
    overflow: hidden;
    box-sizing: border-box;
  }

  .platform-bg-branding {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .platform-radial-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 700px;
    height: 480px;
    background: radial-gradient(circle, rgba(0, 198, 255, 0.12) 0%, rgba(0, 114, 255, 0.05) 50%, transparent 80%);
    filter: blur(80px);
    border-radius: 50%;
  }

  .platform-card-wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1140px;
    max-height: calc(100svh - 4rem);
    margin: 0 auto;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 24px;
    padding: clamp(1.5rem, 3vh, 2.5rem) clamp(1.5rem, 3vw, 3rem);
    box-shadow: 0 12px 32px -8px rgba(15, 23, 42, 0.06), 0 4px 12px -2px rgba(0, 114, 255, 0.04);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    box-sizing: border-box;
  }

  /* Coluna de Texto */
  .platform-text-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    flex: 1.25;
    min-width: 0;
  }

  .platform-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.8rem;
    border-radius: 9999px;
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    color: #0072FF;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: clamp(0.75rem, 1.8vh, 1.25rem);
  }

  .dot-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0072FF;
    box-shadow: 0 0 0 2px rgba(0, 114, 255, 0.25);
  }

  .platform-statement {
    font-size: clamp(1.25rem, 2.1vw, 1.85rem);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.03em;
    color: #1E293B;
    margin-bottom: clamp(0.6rem, 1.5vh, 1rem);
  }

  .platform-statement strong {
    font-weight: 800;
    color: #0F172A;
  }

  .platform-punchline {
    font-size: clamp(0.95rem, 1.3vw, 1.18rem);
    font-weight: 700;
    color: #0072FF;
    line-height: 1.35;
    margin-bottom: clamp(1rem, 2.2vh, 1.6rem);
  }

  .platform-pillars-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .pillar-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    color: #334155;
    font-size: clamp(0.72rem, 0.9vw, 0.8rem);
    font-weight: 600;
    padding: 0.45rem 0.85rem;
    border-radius: 9999px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
    white-space: nowrap;
  }

  .pillar-pill svg {
    color: #0072FF;
    flex-shrink: 0;
  }

  /* Coluna de Imagem / Personagem */
  .platform-image-column {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 0.85;
    min-width: 0;
  }

  .character-illustration-frame {
    position: relative;
    width: 100%;
    max-width: clamp(200px, 24vw, 320px);
    max-height: clamp(200px, 42vh, 340px);
    border-radius: 20px;
    overflow: hidden;
    background: #F0F9FF;
    border: 1px solid #E0F2FE;
    box-shadow: 0 8px 24px -4px rgba(0, 114, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .character-image {
    width: 100%;
    height: 100%;
    max-height: clamp(200px, 42vh, 340px);
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .character-illustration-frame:hover .character-image {
    transform: scale(1.03);
  }

  .character-caption-badge {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-weight: 700;
    color: #0F172A;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .badge-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
  }

  /* Responsivo Mobile */
  @media (max-width: 800px) {
    .platform-section-clean {
      height: 100svh;
      padding: 1.25rem 1rem;
      align-items: center;
    }

    .platform-card-wrap {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
      padding: 1.25rem 1rem;
      max-height: 92svh;
      overflow-y: auto;
    }

    .platform-text-column {
      align-items: center;
      text-align: center;
      flex: none;
    }

    .platform-statement {
      font-size: 1.15rem;
      line-height: 1.3;
      margin-bottom: 0.5rem;
    }

    .platform-punchline {
      font-size: 0.95rem;
      margin-bottom: 0.85rem;
    }

    .platform-pillars-row {
      justify-content: center;
      gap: 0.35rem;
    }

    .character-illustration-frame {
      max-width: 180px;
      max-height: 180px;
    }

    .character-caption-badge {
      display: none;
    }
  }
</style>
