---
// HeroSection.astro - Seção 1: Pluri Health — Healthtech de Gestão Clínica & Lançamento Pluri Fisio
---

<section
  id="institucional"
  aria-labelledby="institucional-titulo"
  class="snap-page hero-aurora hero-section"
>
  <div aria-hidden="true" class="hero-grid"></div>
  <div aria-hidden="true" class="hero-orbit orbit-1"></div>
  <div aria-hidden="true" class="hero-orbit orbit-2"></div>
  
  <div class="hero-brand-top">
    <img
      src="/branding/logo/pluri_health_icon_gradient.svg"
      alt="Pluri Health"
      class="hero-logo-mark"
      width="54"
      height="54"
      loading="eager"
      decoding="async"
    />
    <div class="hero-badge-pill">
      <span class="badge-dot"></span>
      <span class="t-small hero-badge">
        HEALTHTECH DE GESTÃO CLÍNICA
      </span>
    </div>
  </div>

  <h1 id="institucional-titulo" class="hero-title">
    Tecnologia inteligente para gestão e rotina da sua clínica.
  </h1>

  <p class="hero-lead">
    A Pluri Health desenvolve soluções clínicas integradas que unem prontuário eletrônico ultraveloz, agendamentos sem fricção e gestão completa para equipes de saúde.
  </p>

  <!-- Banner de Destaque: Lançamento Pluri Fisio -->
  <div class="hero-launch-banner">
    <div class="launch-banner-glow"></div>
    <div class="launch-banner-content">
      <span class="launch-pill">NOVIDADE</span>
      <div class="launch-text">
        <strong>Lançamento Oficial: Pluri Fisio</strong> — A primeira vertical especializada em fisioterapia e reabilitação.
      </div>
      <a 
        href="https://plurifisio.com.br" 
        target="_blank" 
        rel="noopener"
        class="launch-direct-link"
        title="Acessar plurifisio.com.br em nova aba"
      >
        <span>Acessar plurifisio.com.br</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <div class="hero-actions">
    <a 
      href="https://plurifisio.com.br" 
      target="_blank" 
      rel="noopener" 
      class="btn-clay hero-btn hero-btn-cta"
    >
      Conhecer o Pluri Fisio
      <svg aria-hidden="true" class="icon-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </a>
    <a href="#gestao-clinica" class="btn-ink hero-btn">
      Soluções para Clínicas
    </a>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2.5vmin, 1.8rem);
    padding-inline: max(1.5rem, 6vmin);
    padding-top: 4.5rem;
    padding-bottom: 2rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-brand-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.15rem;
    position: relative;
    z-index: 2;
  }

  .hero-logo-mark {
    width: clamp(84px, 12vmin, 130px);
    height: auto;
    display: block;
    filter: drop-shadow(0 12px 32px rgba(0, 114, 255, 0.4));
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-logo-mark:hover {
    transform: scale(1.06);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, rgba(0, 0, 0, 0.035) 1px, transparent 1px),
                      linear-gradient(to bottom, rgba(0, 0, 0, 0.035) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-orbit {
    position: absolute;
    border-radius: 9999px;
    border: 1px solid rgba(0, 114, 255, 0.12);
    pointer-events: none;
    z-index: 0;
    animation: orbitRotate 30s linear infinite;
  }

  .orbit-1 {
    left: 50%;
    top: 50%;
    width: min(120vmin, 120vmax);
    height: min(120vmin, 120vmax);
    transform: translate(-50%, -50%);
  }

  .orbit-2 {
    left: 50%;
    top: 50%;
    width: min(78vmin, 78vmax);
    height: min(78vmin, 78vmax);
    transform: translate(-50%, -50%);
    animation-delay: -6s;
  }

  @keyframes orbitRotate {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    background: rgba(0, 114, 255, 0.08);
    border: 1px solid rgba(0, 114, 255, 0.18);
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--clay);
    box-shadow: 0 0 8px var(--clay);
  }

  .hero-badge {
    font-size: clamp(0.72rem, 1.4vmin, 0.85rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--clay);
  }

  .hero-title {
    position: relative;
    z-index: 2;
    font-size: clamp(1.95rem, 4.2vmin, 3.4rem);
    font-weight: 700;
    line-height: 1.15;
    max-width: 26ch;
    color: var(--foreground);
    letter-spacing: -0.025em;
    margin: 0;
  }

  .hero-lead {
    position: relative;
    z-index: 2;
    font-size: clamp(1rem, 2vmin, 1.25rem);
    font-weight: 450;
    line-height: 1.55;
    max-width: 52ch;
    color: var(--muted-foreground);
    margin: 0;
  }

  /* Banner de Destaque: Lançamento Pluri Fisio */
  .hero-launch-banner {
    position: relative;
    z-index: 2;
    max-width: 760px;
    width: 100%;
    margin-top: 0.25rem;
    border-radius: 1.25rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(240, 246, 255, 0.85));
    border: 1px solid rgba(0, 114, 255, 0.2);
    box-shadow: 0 10px 30px rgba(0, 114, 255, 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
    padding: 0.9rem 1.4rem;
  }

  .launch-banner-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .launch-pill {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: #0072ff;
    color: #ffffff;
    flex-shrink: 0;
  }

  .launch-text {
    font-size: 0.92rem;
    color: var(--foreground);
    text-align: left;
    flex: 1;
    min-width: 240px;
  }

  .launch-text strong {
    color: #0056cc;
  }

  .launch-direct-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: #0066f5;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .launch-direct-link:hover {
    color: #0044b3;
    transform: translateX(2px);
  }

  .hero-actions {
    position: relative;
    z-index: 2;
    margin-top: clamp(0.5rem, 1.2vmin, 1rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .hero-btn {
    min-height: 3.25rem !important;
    padding-inline: clamp(1.5rem, 3.2vmin, 2.5rem) !important;
    font-size: clamp(0.95rem, 2vmin, 1.15rem) !important;
    font-weight: 600 !important;
    text-decoration: none;
    border-radius: 9999px;
  }

  .icon-arrow {
    display: inline-block;
    vertical-align: middle;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 1.85rem;
      line-height: 1.22;
      max-width: 100%;
    }

    .hero-lead {
      font-size: 1rem;
      max-width: 100%;
    }

    .hero-actions {
      width: 100%;
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
