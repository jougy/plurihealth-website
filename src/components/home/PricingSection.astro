---
// PricingSection.astro - Seção de Planos da Pluri Health (Bento Interativo 100svh)
import { BILLING_CYCLES, PROF_PLANS, CLINIC_PLANS, PRICES } from '../../data/pricing-plans';

const initialPlan = PROF_PLANS[1];
const initialPrice = PRICES[initialPlan.id].mensal;
const initialFeatures = initialPlan.features.filter((f) => !f.text.startsWith('Consultoria'));
const initialHints = ['Iniciando', 'Alta demanda', 'Com secretária'];

const audiences = [
  { id: 'prof', label: 'Profissional', btn: 'btnAudienceProf', icon: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>' },
  { id: 'clinic', label: 'Clínica', btn: 'btnAudienceClinic', icon: '<path d="M3 21h18"></path><path d="M9 8h1"></path><path d="M9 12h1"></path><path d="M9 16h1"></path><path d="M14 8h1"></path><path d="M14 12h1"></path><path d="M14 16h1"></path><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path>' },
  { id: 'enterprise', label: 'Enterprise', btn: 'btnAudienceEnterprise', icon: '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>' },
];

const enterpriseItems = [
  ['Migração Assistida VIP', 'Importação completa dos dados do seu sistema anterior.'],
  ['Múltiplas unidades e filiais', 'Permissões avançadas por unidade, gestor e especialidade.'],
  ['SLA dedicado e treinamento', 'Canal exclusivo direto com suporte prioritário.'],
  ['Integrações sob medida', 'API aberta, faturamento TISS/TUSS e ERPs.'],
];
---

<section id="planos" aria-labelledby="planos-titulo" class="snap-page plans-section">
  <div class="plans-ambient-bg" aria-hidden="true">
    <div class="ambient-spot ambient-spot-1"></div>
    <div class="ambient-spot ambient-spot-2"></div>
  </div>

  <div class="bento" id="planosBento">
    <!-- ================= Coluna esquerda: controles ================= -->
    <div class="bento-controls">
      <div class="bento-meta-badge-row">
        <span class="bento-eyebrow"><span aria-hidden="true">⚡</span> Planos Pluri Health</span>
        <span class="product-scope-tag">Produto Completo · Sem Barreiras</span>
      </div>
      
      <h2 id="planos-titulo" class="bento-title">Tecnologia completa que cresce com a sua rotina médica e clínica.</h2>
      <p class="bento-lead">
        Escolha o seu perfil, a intensidade do seu consultório e o ciclo. O produto Pluri Health oferece acesso total a todas as especialidades e módulos do ecossistema.
      </p>

      <!-- Diferenciação de Produto: Pluri Health vs Pluri Fisio -->
      <aside class="vertical-differentiator-box">
        <div class="diff-icon" aria-hidden="true">ℹ️</div>
        <div class="diff-content">
          <strong>Atua exclusivamente com Fisioterapia ou Terapia Ocupacional?</strong>
          <span>Conheça a vertical dedicada <a href="https://plurifisio.com.br" target="_blank" rel="noopener" class="fisio-direct-link">Pluri Fisio ↗</a>, customizada para rotina na maca com barreiras específicas da área.</span>
        </div>
      </aside>

      <div class="audience-toggle-wrapper" role="tablist" aria-label="Seletor de Perfil">
        {audiences.map((a, i) => (
          <button
            type="button"
            id={a.btn}
            class={`audience-toggle-btn ${i === 0 ? 'active' : ''}`}
            data-audience={a.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={a.icon}></svg>
            <span>{a.label}</span>
          </button>
        ))}
      </div>

      <div role="group" aria-label="Ciclo de cobrança" class="cycles-switcher" id="cyclesSwitcherGroup">
        {BILLING_CYCLES.map((c) => (
          <button type="button" data-cycle={c.id} class={`cycle-btn ${c.id === 'mensal' ? 'active' : ''}`}>
            <span>{c.label}</span>
            {c.note ? <span class="cycle-note">{c.note}</span> : null}
          </button>
        ))}
      </div>

      <!-- Slider de porte: Básico → Médio → Top -->
      <div class="bento-stepper" id="bentoStepper">
        <div class="bento-stepper-head">
          <span>Porte do seu atendimento</span>
        </div>
        <input
          id="bentoSlider"
          class="bento-slider"
          type="range"
          min="0"
          max="2"
          step="1"
          value="1"
          aria-label="Selecionar plano por porte"
          style="--fill: 50%;"
        />
        <div class="bento-steps">
          {PROF_PLANS.map((p, i) => (
            <button type="button" class={`bento-step ${i === 1 ? 'active' : ''}`} aria-pressed={i === 1 ? 'true' : 'false'}>
              <span class="bento-step-name">{p.name}</span>
              <span class="bento-step-hint">{initialHints[i]}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Banner persistente do teste grátis -->
      <button type="button" class="trial-banner" id="btnOpenFreePlan" aria-label="Conhecer o teste gratuito de 7 dias">
        <span class="trial-banner-badge">7 DIAS GRÁTIS</span>
        <span class="trial-banner-text"><strong>Sem cartão de crédito:</strong> Teste a Pluri Health gratuitamente por 7 dias</span>
        <span class="trial-banner-cta">
          Conhecer
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </span>
      </button>

      <p class="bento-trust">
        <span>✔ Sem fidelidade</span><span>·</span><span>Ativação imediata</span><span>·</span><span>PIX com 5% off</span>
      </p>
    </div>

    <!-- ================= Coluna direita: palco ================= -->
    <div class="bento-stage">
      <!-- Plano pagos (profissional/clínica) -->
      <article class:list={['plan-card bento-card', { 'is-featured': initialPlan.featured }]} id="bentoCard">
        <div class="bento-card-body" id="bentoCardBody">
          <header class="bento-card-head">
            <div class="bento-card-id">
              <span class="bento-badge is-popular" id="bentoBadge">{initialPlan.badge}</span>
              <h3 class="bento-name" id="bentoName">{initialPlan.name}</h3>
              <p class="bento-tagline" id="bentoTagline">{initialPlan.tagline}</p>
            </div>
            <div class="bento-price-box">
              <div class="bento-price" id="bentoPrice" data-price-main>{initialPrice.main}</div>
              <div class="bento-sub" id="bentoSub" data-price-sub>{initialPrice.sub}</div>
              <span class="bento-save" id="bentoSave" hidden></span>
            </div>
          </header>

          <div class="launch-box">
            <span class="launch-icon" aria-hidden="true">🎁</span>
            <div>
              <strong>Ecossistema Completo sem Restrições</strong>
              <span>Consultoria VIP de implantação e prontuário adaptável inclusos</span>
            </div>
          </div>

          <ul class="bento-features" id="bentoFeatures" role="list">
            {initialFeatures.map((f) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>{f.bold ? <strong>{f.text}</strong> : f.text}</span>
              </li>
            ))}
          </ul>

          <div class="bento-actions">
            <a
              id="bentoCta"
              href={`https://app.plurihealth.com.br/cadastro?plan=${initialPlan.id}&cycle=monthly&origin=plurihealth`}
              class="plan-cta-btn bento-cta-primary"
              data-plan-id={initialPlan.id}
              data-plan-name={initialPlan.name}
              data-audience={initialPlan.audience}
              data-cycle="mensal"
            >
              <span id="bentoCtaLabel">Assinar {initialPlan.name}</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
            <a href="https://app.plurihealth.com.br/cadastro?trial=true&origin=plurihealth" class="free-card-cta bento-cta-trial">
              Testar 7 dias grátis
            </a>
          </div>
        </div>
      </article>

      <!-- Enterprise -->
      <article class="bento-enterprise" id="bentoEnterprise" hidden>
        <span class="ent-badge">Grandes redes hospitalares e clínicas</span>
        <h3 class="ent-title">Pluri Health Enterprise sob medida</h3>
        <p class="ent-lead">Governança clínica avançada, auditoria total, integrações personalizadas e suporte 24/7 para redes com mais de 30 profissionais.</p>
        <ul class="ent-grid" role="list">
          {enterpriseItems.map(([t, d]) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#38BDF8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <div><strong>{t}</strong><span>{d}</span></div>
            </li>
          ))}
        </ul>
        <div class="bento-actions">
          <a
            href="https://app.plurihealth.com.br/cadastro?plan=enterprise&cycle=annual&origin=plurihealth"
            class="enterprise-primary-btn"
            data-plan-id="enterprise"
            data-plan-name="Enterprise"
            data-audience="enterprise"
            data-cycle="anual"
          >Contratar Enterprise</a>
          <a
            href="https://wa.me/5511999999999?text=Ol%C3%A1%2C%20gostaria%20de%20conversar%20sobre%20o%20Plano%20Enterprise%20da%20Pluri%20Health"
            target="_blank"
            rel="noopener"
            class="ent-secondary"
          >Falar com consultor</a>
        </div>
      </article>

      <!-- Teste grátis -->
      <article class="bento-trial" id="bentoTrial" hidden>
        <div class="trial-top">
          <span class="trial-pill">TESTE GRATUITO</span>
          <button type="button" class="trial-back" data-close-trial>← Ver planos</button>
        </div>
        <h3 class="trial-title">7 dias grátis, sem cartão de crédito</h3>
        <p class="trial-lead">Experimente a Pluri Health na prática clínica com toda a sua equipe. Sem compromisso e sem fidelidade.</p>
        <div class="trial-specs">
          <div><b>7 dias</b><span>de acesso total</span></div>
          <div><b>Ilimitado</b><span>módulos liberados</span></div>
          <div><b>R$ 0</b><span>sem cartão</span></div>
        </div>
        <ul class="bento-features" role="list">
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span><strong>Prontuário eletrônico completo</strong> e agenda WhatsApp</span></li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span><strong>Sem bloqueio de nicho</strong> para qualquer especialidade</span></li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span><strong>Consultoria VIP</strong> de implantação sem custos</span></li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Cancele quando quiser com 1 clique</span></li>
        </ul>
        <div class="bento-actions">
          <a
            href="https://app.plurihealth.com.br/cadastro?trial=true&origin=plurihealth"
            class="free-card-cta bento-cta-trial is-solid"
            data-plan-name="Teste Gratuito 7 Dias"
            data-plan-id="free_trial"
          >Começar teste grátis</a>
        </div>
      </article>
    </div>

    <!-- Conteúdo textual para acessibilidade e motores de busca -->
    <div class="sr-only">
      <h3>Tabela de preços Pluri Health</h3>
      <ul>
        {[...PROF_PLANS, ...CLINIC_PLANS].map((p) => (
          <li>
            Plano {p.audience === 'prof' ? 'Profissional' : 'Clínica'} {p.name}: {PRICES[p.id].mensal.main} no mensal, {PRICES[p.id].trimestral.main} no trimestral e {PRICES[p.id].anual.main} no anual. {p.tagline}.
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  [hidden] { display: none !important; }

  .plans-section {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.6rem, 2vh, 1.5rem) clamp(0.9rem, 3vw, 2.5rem);
    padding-top: clamp(3.6rem, 8vh, 5rem);
    background-color: var(--background, #FAFBFD);
    box-sizing: border-box;
    overflow: hidden;
  }

  .plans-ambient-bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .ambient-spot { position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.4; }
  .ambient-spot-1 { top: -10%; left: 8%; width: 42vw; height: 42vh; background: radial-gradient(circle, rgba(0,114,255,.16), transparent 70%); }
  .ambient-spot-2 { bottom: -12%; right: 8%; width: 38vw; height: 38vh; background: radial-gradient(circle, rgba(0,198,255,.14), transparent 70%); }

  .bento {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1140px;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.25rem, 3.5vw, 3rem);
    align-items: center;
  }

  /* ---------- Coluna esquerda ---------- */
  .bento-controls {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.6rem, 1.6vh, 1rem);
    min-width: 0;
  }

  .bento-meta-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .bento-eyebrow {
    display: inline-flex; gap: .35rem; align-items: center;
    background: #DBEAFE; color: #1D4ED8;
    font-size: .74rem; font-weight: 800; padding: .25rem .7rem; border-radius: 999px;
  }

  .product-scope-tag {
    display: inline-flex;
    align-items: center;
    font-size: .72rem;
    font-weight: 700;
    color: #0369A1;
    background: #E0F2FE;
    padding: .25rem .65rem;
    border-radius: 999px;
    border: 1px solid #BAE6FD;
  }

  .bento-title {
    font-size: clamp(1.5rem, 3.2vw, 2.3rem);
    font-weight: 800; line-height: 1.15; letter-spacing: -0.03em; color: #0F172A; margin: 0;
  }

  .bento-lead { font-size: clamp(.8rem, 1.05vw, .92rem); color: #475569; line-height: 1.45; margin: 0; max-width: 34rem; }

  /* Caixa comparativa de produto */
  .vertical-differentiator-box {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    background: #F8FAFC;
    border: 1px dashed #CBD5E1;
    border-radius: 12px;
    padding: 0.55rem 0.8rem;
    font-size: 0.76rem;
    color: #475569;
    line-height: 1.35;
    max-width: 32rem;
  }
  .vertical-differentiator-box .diff-icon {
    font-size: 0.95rem;
    line-height: 1;
    margin-top: 1px;
  }
  .vertical-differentiator-box strong {
    display: block;
    color: #1E293B;
    font-weight: 700;
  }
  .fisio-direct-link {
    color: #0072FF;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .fisio-direct-link:hover {
    color: #0056b3;
  }

  .audience-toggle-wrapper, .cycles-switcher {
    display: inline-flex; align-items: center; gap: .15rem; padding: .2rem;
    background: #F1F5F9; border: 1px solid #E2E8F0; border-radius: 999px; max-width: 100%;
  }

  .audience-toggle-btn, .cycle-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .3rem;
    padding: .38rem .8rem; border-radius: 999px; background: transparent;
    color: #64748B; font-size: .8rem; font-weight: 700; cursor: pointer; white-space: nowrap;
    transition: background-color .18s ease, color .18s ease, box-shadow .18s ease;
  }
  .audience-toggle-btn:hover, .cycle-btn:hover { color: #0F172A; }
  .audience-toggle-btn.active { background: #fff; color: #0072FF; box-shadow: 0 2px 6px rgba(15,23,42,.1); }
  .cycle-btn.active { background: #0F172A; color: #fff; }
  .cycle-note { font-size: .66rem; font-weight: 800; color: #0072FF; }
  .cycle-btn.active .cycle-note { color: #38BDF8; }

  /* Slider */
  .bento-stepper {
    width: 100%; max-width: 30rem;
    background: #fff; border: 1px solid #E2E8F0; border-radius: 18px;
    padding: clamp(.7rem, 1.6vh, 1rem) 1rem; box-shadow: 0 4px 14px rgba(15,23,42,.04);
    display: flex; flex-direction: column; gap: .6rem;
  }
  .bento-stepper-head { font-size: .74rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: #64748B; }

  .bento-slider {
    -webkit-appearance: none; appearance: none; width: 100%; height: 8px; border-radius: 999px; cursor: pointer;
    background: linear-gradient(90deg, #0072FF var(--fill, 50%), #E2E8F0 var(--fill, 50%));
    outline-offset: 4px;
  }
  .bento-slider::-webkit-slider-thumb {
    -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%;
    background: #fff; border: 3px solid #0072FF; box-shadow: 0 2px 8px rgba(0,114,255,.35);
    transition: transform .15s ease;
  }
  .bento-slider::-webkit-slider-thumb:hover { transform: scale(1.12); }
  .bento-slider::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: #fff; border: 3px solid #0072FF; }

  .bento-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: .25rem; }
  .bento-step {
    display: flex; flex-direction: column; gap: .1rem; padding: .3rem .25rem; border-radius: 10px;
    background: transparent; text-align: center; color: #64748B; transition: background-color .18s ease, color .18s ease;
  }
  .bento-step:nth-child(1) { text-align: left; }
  .bento-step:nth-child(3) { text-align: right; }
  .bento-step-name { font-size: .88rem; font-weight: 800; }
  .bento-step-hint { font-size: .7rem; font-weight: 600; opacity: .85; }
  .bento-step.active { color: #0072FF; }

  /* Banner teste grátis */
  .trial-banner {
    display: inline-flex; align-items: center; gap: .55rem; max-width: 100%;
    background: linear-gradient(90deg, #F0FDF4, #ECFDF5); border: 1px solid #86EFAC; color: #166534;
    border-radius: 16px; padding: .5rem .8rem; font-size: .8rem; text-align: left; cursor: pointer;
    box-shadow: 0 2px 8px rgba(34,197,94,.12);
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .trial-banner:hover { transform: translateY(-1px); border-color: #4ADE80; box-shadow: 0 6px 16px rgba(34,197,94,.2); }
  .trial-banner-badge { background: #16A34A; color: #fff; font-size: .64rem; font-weight: 800; padding: .15rem .5rem; border-radius: 999px; white-space: nowrap; letter-spacing: .04em; }
  .trial-banner-text { line-height: 1.3; }
  .trial-banner-text strong { color: #14532D; }
  .trial-banner-cta { display: inline-flex; align-items: center; gap: .15rem; font-weight: 800; color: #15803D; white-space: nowrap; }

  .bento-trust { display: flex; flex-wrap: wrap; gap: .4rem; font-size: .74rem; color: #64748B; margin: 0; }

  /* ---------- Palco direito ---------- */
  .bento-stage { min-width: 0; }

  .bento-card, .bento-enterprise, .bento-trial {
    border-radius: 26px; padding: clamp(1rem, 2.6vh, 1.9rem) clamp(1.1rem, 2.4vw, 2rem);
    box-shadow: 0 18px 44px -14px rgba(15,23,42,.18); box-sizing: border-box;
  }

  .bento-card { position: relative; background: #fff; border: 2px solid #E2E8F0; transition: border-color .25s ease, box-shadow .25s ease; }
  .bento-card.is-featured { border-color: #0072FF; box-shadow: 0 20px 48px -12px rgba(0,114,255,.28); }

  .bento-card-body, .bento-enterprise, .bento-trial { display: flex; flex-direction: column; gap: clamp(.65rem, 1.8vh, 1.15rem); }
  .swap { animation: bentoSwap .28s cubic-bezier(.16,1,.3,1); }
  @keyframes bentoSwap { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  .bento-card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .bento-card-id { min-width: 0; }
  .bento-badge { display: inline-block; background: #F1F5F9; color: #475569; font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; padding: .22rem .65rem; border-radius: 999px; }
  .bento-badge.is-popular { background: linear-gradient(135deg, #0072FF, #00C6FF); color: #fff; }
  .bento-name { font-size: clamp(1.4rem, 2.4vw, 1.9rem); font-weight: 900; color: #0F172A; margin: .4rem 0 .1rem; letter-spacing: -.02em; line-height: 1.1; }
  .bento-tagline { font-size: .84rem; color: #64748B; margin: 0; line-height: 1.35; }

  .bento-price-box { text-align: right; flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: .2rem; }
  .bento-price { font-size: clamp(1.6rem, 3vw, 2.3rem); font-weight: 900; color: #0F172A; letter-spacing: -.03em; line-height: 1; white-space: nowrap; }
  .bento-sub { font-size: .74rem; color: #64748B; font-weight: 600; }
