---
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';
---

<section class="clinical-section hero-section" id="inicio">
  <div class="container hero-container">
    
    <!-- Hero Text & Value Proposition -->
    <div class="hero-content">
      
      <!-- Authority & Trust Badges -->
      <div class="hero-badges">
        <Badge variant="teal">
          📱 Use no Celular ou Computador
        </Badge>
        <Badge variant="sage">
          Plano Gratuito Vitalício por Uso
        </Badge>
        <Badge variant="neutral">
          Sem Cartão de Crédito
        </Badge>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title">
        Você se dedicou para cuidar de vidas. Não para ser refém de fichas perdidas.
      </h1>

      <!-- Subtitle / Value Prop -->
      <p class="hero-subtitle">
        Chega de cadernos rasgando, horas perdidas anotando tudo à mão e noites de estresse com papelada. Tenha a ficha do paciente em 90 segundos, botão de WhatsApp em 1 clique sem salvar contato e todo o seu consultório direto no celular.
      </p>

      <!-- CTA Buttons -->
      <div class="hero-actions">
        <Button href="#planos" variant="primary" size="lg">
          Começar Grátis sem Cartão
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </Button>
        <Button href="#recursos" variant="secondary" size="lg">
          Ver Como Funciona
        </Button>
      </div>

      <!-- Trust Subtext -->
      <p class="hero-trust-info">
        ⚡ 20 atendimentos gratuitos inclusos • Passamos suas fichas antigas de papel de graça para o sistema • Comece agora
      </p>
    </div>

    <!-- Authentic Pluri Health Interface Mockup -->
    <div class="hero-mockup-wrapper">
      <div class="hero-mockup-window">
        
        <!-- Mockup App Topbar -->
        <div class="mockup-topbar">
          <div class="mockup-topbar-left">
            <div class="mockup-brand">
              <img 
                src="/branding/logo/pluri_health_icon_gradient.svg" 
                alt="Pluri Health" 
                class="mockup-pluri-icon" 
                width="22" 
                height="22" 
              />
              <span>Pluri Health</span>
            </div>
          </div>
          <div class="mockup-topbar-right">
            <div class="mockup-tutorial-btn">
              <span>✨ Tutorial & Guia</span>
            </div>
            <div class="mockup-user-pill">
              <div class="user-avatar">U</div>
              <span class="user-name">Dra. Camila</span>
            </div>
          </div>
        </div>

        <!-- Mockup Search & Filter Bar -->
        <div class="mockup-search-bar">
          <div class="search-input-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span>Buscar paciente, CPF ou telefone...</span>
            <span class="search-kbd">⌘K</span>
          </div>
          <div class="search-actions">
            <div class="icon-btn" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
            </div>
            <div class="add-patient-btn" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </div>
          </div>
        </div>

        <!-- Mockup Main Body Grid -->
        <div class="mockup-body">
          
          <!-- Left Column: Real Patient Card List -->
          <div class="mockup-patients-list">
            <div class="list-section-header">
              <span>Pacientes recentes</span>
              <span class="text-muted">6 cadastrados</span>
            </div>

            <!-- Patient Card 1: Active Focus -->
            <div class="real-patient-card active-card">
              <div class="card-main-info">
                <div class="card-title-row">
                  <span class="gender-icon">♂</span>
                  <strong class="patient-title-name">Eduardo Henrique Vianna</strong>
                  <span class="badge badge-sage badge-sm">Ativo</span>
                  
                  <!-- Days of Week Schedule Pills -->
                  <div class="week-days-pills">
                    <span class="day-dot">D</span>
                    <span class="day-dot active-day">S</span>
                    <span class="day-dot active-day">T</span>
                    <span class="day-dot active-day">Q</span>
                    <span class="day-dot">Q</span>
                    <span class="day-dot">S</span>
                    <span class="day-dot">S</span>
                  </div>
                </div>

                <div class="card-sub-info">
                  <span>📞 (11) 94567-8945</span>
                  <span>•</span>
                  <span>Último: Hoje</span>
                </div>

                <div class="card-tags-row">
                  <span class="tag-pill tag-purple">Coluna Cervical</span>
                  <span class="tag-pill tag-peach">Liberação Miofascial</span>
                </div>
              </div>

              <div class="card-right-action">
                <div class="whatsapp-quick-btn" title="Chamar no WhatsApp em 1 clique">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
                  </svg>
                  <span>Chamar</span>
                </div>
                <div class="chevron-arrow">›</div>
              </div>
            </div>

            <!-- Patient Card 2 -->
            <div class="real-patient-card">
              <div class="card-main-info">
                <div class="card-title-row">
                  <span class="gender-icon">♀</span>
                  <strong class="patient-title-name">Juliana Mendes Fonseca</strong>
                  <span class="badge badge-sage badge-sm">Ativo</span>
                  
                  <div class="week-days-pills">
                    <span class="day-dot">D</span>
                    <span class="day-dot active-day">S</span>
                    <span class="day-dot">T</span>
                    <span class="day-dot active-day">Q</span>
                    <span class="day-dot">Q</span>
                    <span class="day-dot active-day">S</span>
                    <span class="day-dot">S</span>
                  </div>
                </div>

                <div class="card-sub-info">
                  <span>📞 (11) 95456-7834</span>
                  <span>•</span>
                  <span>Último: 23/08</span>
                </div>

                <div class="card-tags-row">
                  <span class="tag-pill tag-teal">Tornozelo e Pé</span>
                  <span class="tag-pill tag-amber">Fortalecimento</span>
                </div>
              </div>

              <div class="card-right-action">
                <div class="whatsapp-quick-btn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/></svg>
                  <span>Chamar</span>
                </div>
                <div class="chevron-arrow">›</div>
              </div>
            </div>

            <!-- Patient Card 3 -->
            <div class="real-patient-card">
              <div class="card-main-info">
                <div class="card-title-row">
                  <span class="gender-icon">♀</span>
                  <strong class="patient-title-name">Camila Beatriz Rocha</strong>
                  <span class="badge badge-sage badge-sm">Ativo</span>
                  
                  <div class="week-days-pills">
                    <span class="day-dot">D</span>
                    <span class="day-dot active-day">S</span>
                    <span class="day-dot active-day">T</span>
                    <span class="day-dot active-day">Q</span>
                    <span class="day-dot">Q</span>
                    <span class="day-dot">S</span>
                    <span class="day-dot">S</span>
                  </div>
                </div>

                <div class="card-sub-info">
                  <span>📞 (11) 97234-5612</span>
                  <span>•</span>
                  <span>Último: 20/08</span>
                </div>

                <div class="card-tags-row">
                  <span class="tag-pill tag-coral">Coluna Lombar</span>
                  <span class="tag-pill tag-purple">Pilates Clínico</span>
                </div>
              </div>

              <div class="card-right-action">
                <div class="whatsapp-quick-btn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/></svg>
                  <span>Chamar</span>
                </div>
                <div class="chevron-arrow">›</div>
              </div>
            </div>
          </div>

          <!-- Right Column: Active Patient Overview & Timeline -->
          <div class="mockup-patient-preview">
            
            <div class="preview-header">
              <div>
                <span class="preview-label">FICHA DO PACIENTE</span>
                <h4 class="preview-patient-name">Eduardo Henrique Vianna</h4>
                <div class="preview-patient-meta">
                  <span>61 anos</span> • <span class="text-sage font-bold">✓ Cadastro concluído</span>
                </div>
              </div>
              <div class="start-session-btn">
                <span>▶ Iniciar Atendimento</span>
              </div>
            </div>

            <!-- 2 Stat Blocks -->
            <div class="preview-stats-grid">
              <div class="stat-mini-card">
                <span class="stat-mini-label">PRESENÇA & HISTÓRICO</span>
                <strong class="stat-mini-val text-teal">6 atendimentos</strong>
                <span class="stat-mini-sub">5 concluídos • 0 faltas</span>
              </div>
              <div class="stat-mini-card">
                <span class="stat-mini-label">FINANCEIRO</span>
                <strong class="stat-mini-val text-sage">R$ 670,00</strong>
                <span class="stat-mini-sub">Pacote 8 sessões (4/8)</span>
              </div>
            </div>

            <!-- Evolution Timeline Sample -->
            <div class="preview-timeline">
              <div class="timeline-title">Linha do Tempo de Atendimentos</div>
              
              <div class="timeline-item">
                <div class="timeline-marker marker-sage"></div>
                <div class="timeline-content-box">
                  <div class="timeline-date-row">
                    <span class="date-text">Hoje • 01/09/2026</span>
                    <span class="badge badge-sage badge-sm">Concluído</span>
                  </div>
                  <p class="timeline-desc">"Sem dor cervical na semana. Mobilidade preservada e melhora importante na postura de trabalho."</p>
                  <div class="timeline-tags">
                    <span class="tag-pill tag-purple">Coluna Cervical</span>
                    <span class="tag-pill tag-peach">Liberação Miofascial</span>
                  </div>
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-marker marker-teal"></div>
                <div class="timeline-content-box">
                  <div class="timeline-date-row">
                    <span class="date-text">19/08/2026</span>
                    <span class="badge badge-sage badge-sm">Concluído</span>
                  </div>
                  <p class="timeline-desc">"Trabalhando normalmente com postura adequada. Realizado alongamento e fortalecimento escapular."</p>
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .hero-section {
    padding-top: 4rem;
    padding-bottom: 5.5rem;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-content {
    max-width: 900px;
    margin-bottom: 3.5rem;
  }

  .hero-badges {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.1rem, 4.5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--text-primary);
    margin-bottom: 1.35rem;
    letter-spacing: -0.035em;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 780px;
    margin: 0 auto 2.25rem auto;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .hero-trust-info {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  /* Mockup Interface Styles */
  .hero-mockup-wrapper {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .hero-mockup-window {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 45px -15px rgba(15, 23, 42, 0.08), 0 4px 12px rgba(15, 23, 42, 0.04);
    overflow: hidden;
    text-align: left;
  }

  /* Topbar */
  .mockup-topbar {
    background-color: #ffffff;
    border-bottom: 1px solid var(--border-light);
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mockup-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--text-primary);
  }

  .mockup-pluri-icon {
    width: 1.35rem;
    height: 1.35rem;
    object-fit: contain;
  }

  .mockup-topbar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mockup-tutorial-btn {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-primary-border);
  }

  .mockup-user-pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--bg-subtle);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-light);
  }

  .user-avatar {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .user-name {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Search & Filter Bar */
  .mockup-search-bar {
    background-color: var(--bg-page);
    border-bottom: 1px solid var(--border-light);
    padding: 0.875rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .search-input-box {
    background-color: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    padding: 0.45rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    width: 100%;
    max-width: 420px;
    box-shadow: var(--shadow-sm);
  }

  .search-kbd {
    margin-left: auto;
    font-size: 0.7rem;
    background-color: var(--bg-subtle);
    padding: 0.15rem 0.35rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
  }

  .search-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon-btn {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
    background-color: #ffffff;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .add-patient-btn {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-md);
    border: none;
    background-color: var(--color-primary);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 4px rgba(2, 132, 199, 0.3);
  }

  /* Mockup Body */
  .mockup-body {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    background-color: var(--bg-page);
    min-height: 440px;
  }

  /* Patient List Left Side */
  .mockup-patients-list {
    padding: 1.25rem 1.5rem;
    border-right: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .list-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.15rem;
  }

  .real-patient-card {
    background-color: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 0.95rem 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    box-shadow: var(--shadow-sm);
    transition: all 180ms ease;
  }

  .real-patient-card.active-card {
    border-color: var(--color-primary);
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.1);
  }

  .card-main-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .card-title-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .gender-icon {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .patient-title-name {
    font-size: 0.925rem;
    color: var(--text-primary);
  }

  .badge-sm {
    padding: 0.12rem 0.45rem;
    font-size: 0.7rem;
  }

  .week-days-pills {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    background-color: var(--bg-subtle);
    padding: 2px 4px;
    border-radius: var(--radius-full);
    margin-left: 0.25rem;
  }

  .day-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    font-size: 0.6rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }

  .day-dot.active-day {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .card-sub-info {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .card-tags-row {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.15rem;
  }

  .tag-pill {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .tag-purple { background-color: var(--color-purple-light); color: var(--color-purple); }
  .tag-peach { background-color: var(--color-peach-light); color: var(--color-peach); }
  .tag-teal { background-color: var(--color-primary-light); color: var(--color-primary); }
  .tag-amber { background-color: var(--color-amber-light); color: var(--color-amber); }
  .tag-coral { background-color: var(--color-coral-light); color: var(--color-coral); }

  .card-right-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .whatsapp-quick-btn {
