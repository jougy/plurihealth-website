---
---

<footer class="editorial-footer">
  <div class="container">
    
    <!-- Top Editorial Directory Grid (Apple Style) -->
    <div class="footer-grid">
      
      <!-- Brand Column -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo" aria-label="Pluri Health - Início">
          <img 
            src="/branding/logo/pluri_health_icon_gradient.svg" 
            alt="Pluri Health" 
            class="footer-logo-icon" 
            width="28" 
            height="28"
          />
          <span class="footer-logo-text">Pluri <strong>Health</strong></span>
        </a>

        <p class="footer-brand-desc">
          Healthtech dedicada a transformar a rotina clínica através de tecnologia fluida, simples e sem fricção burocrática para clínicas e consultórios.
        </p>

        <div class="footer-compliance-badges">
          <span class="badge-mini">🛡️ 100% LGPD</span>
          <span class="badge-mini">📱 Web, iOS & Android</span>
          <span class="badge-mini">⚡ Cloud Seguro</span>
        </div>
      </div>

      <!-- Column 1: Produtos & Lançamento -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Nossos Produtos</h4>
        <ul class="footer-links-list">
          <li>
            <a href="https://plurifisio.com.br" target="_blank" rel="noopener" class="link-special">
              Pluri Fisio <span class="tag-live">Lançamento</span> ↗
            </a>
          </li>
          <li><a href="#ecossistema">Pluri Psi (Psicologia)</a></li>
          <li><a href="#ecossistema">Pluri Nutri (Nutrição)</a></li>
          <li><a href="#ecossistema">Pluri Fono (Fonoaudiologia)</a></li>
          <li><a href="#gestao-clinica">Pluri Core (Gestão Clínica)</a></li>
        </ul>
      </div>

      <!-- Column 2: Soluções -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Soluções</h4>
        <ul class="footer-links-list">
          <li><a href="#gestao-clinica">Gestão de Equipes</a></li>
          <li><a href="#gestao-clinica">Agendamentos & Recepção</a></li>
          <li><a href="#como-funciona">Prontuário & Auto-save</a></li>
          <li><a href="#como-funciona">Prescrição e Condutas</a></li>
          <li><a href="#como-funciona">Segurança e LGPD</a></li>
        </ul>
      </div>

      <!-- Column 3: Acesso & Pluri Fisio -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Acesso Rápido</h4>
        <ul class="footer-links-list">
          <li>
            <a href="https://plurifisio.com.br" target="_blank" rel="noopener" class="link-highlight">
              Acessar plurifisio.com.br ↗
            </a>
          </li>
          <li><a href="#planos">Planos & Preços</a></li>
          <li><a href="https://plurifisio.com.br/planos" target="_blank" rel="noopener">Teste Gratuito</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Legal & Copyright -->
    <div class="footer-bottom">
      <div class="footer-copy">
        © {new Date().getFullYear()} Pluri Health Tecnologias em Saúde Ltda. Todos os direitos reservados.
      </div>
      <div class="footer-note">
        Plataforma em conformidade com as diretrizes dos conselhos profissionais de saúde e Lei Geral de Proteção de Dados (Lei nº 13.709/2018).
      </div>
    </div>

  </div>
</footer>

<style>
  .editorial-footer {
    background-color: var(--bg-canvas);
    border-top: 1px solid var(--border-light);
    padding: 5rem 0 3rem 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 3.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--border-light);
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
    text-decoration: none;
  }

  .footer-logo-text {
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 500;
  }

  .footer-logo-text strong {
    font-weight: 800;
    color: var(--color-primary);
  }

  .footer-brand-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 320px;
  }

  .footer-compliance-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge-mini {
    font-size: 0.725rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    background-color: var(--bg-subtle);
    color: var(--text-secondary);
    border: 1px solid var(--border-light);
  }

  .footer-heading {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-links-list a {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-links-list a:hover {
    color: var(--text-primary);
  }

  .link-special {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--tonal-fisio-accent) !important;
  }

  .tag-live {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: var(--tonal-fisio-bg);
    color: var(--tonal-fisio-accent);
    border: 1px solid var(--tonal-fisio-border);
  }

  .link-highlight {
    font-weight: 600;
    color: var(--color-primary) !important;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-top: 2rem;
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  .footer-copy {
    font-weight: 500;
  }

  .footer-note {
    opacity: 0.8;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
    .footer-brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .editorial-footer {
      padding: 3.5rem 0 2rem 0;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-brand-col {
      grid-column: auto;
    }
  }
</style>
