---
import Badge from './ui/Badge.astro';
---

<footer class="clinical-footer">
  <div class="container">
    
    <div class="footer-grid">
      
      <!-- Brand Column -->
      <div class="footer-brand-col">
        <a href="#" class="footer-logo" aria-label="Pluri Health - Voltar ao Topo">
          <img 
            src="/branding/logo/pluri_health_icon_gradient.svg" 
            alt="Pluri Health" 
            class="footer-logo-icon" 
            width="32" 
            height="32"
          />
          <span class="footer-logo-text">Pluri <strong>Health</strong></span>
        </a>

        <p class="footer-brand-desc">
          O sistema simples e prático para o seu consultório ou clínica de saúde direto no celular. Fichas de pacientes, agenda com atalho para WhatsApp e controle de atendimentos.
        </p>

        <div class="footer-badges">
          <Badge variant="sage">🔒 Fichas Seguras & Lei LGPD</Badge>
          <Badge variant="teal">📱 Funciona no Celular ou Computador</Badge>
        </div>
      </div>

      <!-- Links Column 1: Navegação -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Navegação</h4>
        <ul class="footer-links-list">
          <li><a href="#inicio">Início</a></li>
          <li><a href="#evidencias">Pesquisas & Estudos</a></li>
          <li><a href="#recursos">Como Funciona</a></li>
          <li><a href="#planos">Planos & Preços</a></li>
          <li><a href="#faq">Dúvidas Frequentes</a></li>
        </ul>
      </div>

      <!-- Links Column 2: Módulos -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Funcionalidades</h4>
        <ul class="footer-links-list">
          <li><a href="#recursos">Evolução do Paciente em 1 min</a></li>
          <li><a href="#recursos">Agenda & Salas de Atendimento</a></li>
          <li><a href="#recursos">Atalho de WhatsApp em 1 clique</a></li>
          <li><a href="#recursos">Controle de Pacotes & PIX</a></li>
          <li><a href="#recursos">Segurança & Proteção dos Dados</a></li>
        </ul>
      </div>

      <!-- Links Column 3: Planos & Suporte -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Planos & Acesso</h4>
        <ul class="footer-links-list">
          <li><a href="#planos" class="link-highlight">Plano Gratuito Vitalício</a></li>
          <li><a href="#planos">Profissional Solo</a></li>
          <li><a href="#planos">Clínica com Equipe</a></li>
          <li><a href="#planos">Passamos suas Fichas de Papel</a></li>
          <li><a href="https://pluri.health/planos" target="_blank" rel="noopener">Entrar no Sistema</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Compliance -->
    <div class="footer-bottom">
      <div class="footer-copy">
        © {new Date().getFullYear()} Pluri Health. Todos os direitos reservados.
      </div>
      <div class="footer-compliance-text">
        Desenvolvido para profissionais e clínicas de fisioterapia e saúde com total segurança e respeito à Lei Geral de Proteção de Dados (LGPD).
      </div>
    </div>

  </div>
</footer>

<style>
  .clinical-footer {
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-light);
    padding: 4.5rem 0 2.5rem 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text-primary);
  }

  .footer-logo-icon {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .footer-logo-text {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .footer-logo-text strong {
    font-weight: 800;
    color: var(--color-primary);
  }

  .footer-brand-desc {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 340px;
  }

  .footer-badges {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-heading {
    font-family: 'Outfit', sans-serif;
    font-size: 0.975rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  .footer-links-list a {
    color: var(--text-secondary);
    transition: color 180ms ease;
  }

  .footer-links-list a:hover {
    color: var(--color-primary);
  }

  .footer-links-list a.link-highlight {
    color: var(--color-primary);
    font-weight: 700;
  }

  .font-bold {
    font-weight: 700;
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .footer-compliance-text {
    max-width: 600px;
    text-align: right;
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-compliance-text {
      text-align: left;
    }
  }
</style>
