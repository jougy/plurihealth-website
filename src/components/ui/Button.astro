---
interface Props {
  variant?: 'primary' | 'secondary' | 'sage';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  target,
  rel,
  ariaLabel,
} = Astro.props;

const sizeClass = size !== 'md' ? `btn-${size}` : '';
const variantClass = `btn-${variant}`;
const classes = `btn ${variantClass} ${sizeClass} ${className}`.trim();
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
