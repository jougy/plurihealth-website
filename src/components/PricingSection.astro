<script>
  // Official Pricing Engine Sourced from Obsidian Vault & subscriptionPricing.ts
  const PRICING = {
    annual: {
      solo: { amount: "40,00", period: "/mês", total: "Total: R$ 480,00/ano", pix: "PIX: R$ 456,00 (-5%)" },
      clinic: { amount: "60,00", period: "/mês", total: "Total: R$ 720,00/ano", pix: "PIX: R$ 684,00 (-5%)" }
    },
    quarterly: {
      solo: { amount: "48,00", period: "/mês", total: "Total: R$ 144,00/tri", pix: "PIX: R$ 136,80 (-5%)" },
      clinic: { amount: "72,00", period: "/mês", total: "Total: R$ 216,00/tri", pix: "PIX: R$ 205,20 (-5%)" }
    },
    monthly: {
      solo: { amount: "52,00", period: "/mês", total: "Total: R$ 52,00/mês", pix: "PIX: R$ 49,40 (-5%)" },
      clinic: { amount: "78,00", period: "/mês", total: "Total: R$ 78,00/mês", pix: "PIX: R$ 74,10 (-5%)" }
    }
  };

  const cycleBtns = document.querySelectorAll('.cycle-btn');
  const soloAmount = document.getElementById('soloAmount');
  const soloPeriod = document.getElementById('soloPeriod');
  const soloTotal = document.getElementById('soloTotal');
  const soloPix = document.getElementById('soloPix');

  const clinicAmount = document.getElementById('clinicAmount');
  const clinicPeriod = document.getElementById('clinicPeriod');
  const clinicTotal = document.getElementById('clinicTotal');
  const clinicPix = document.getElementById('clinicPix');

  cycleBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cycle = btn.getAttribute('data-cycle');
      if (!cycle || !PRICING[cycle as keyof typeof PRICING]) return;

      cycleBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const data = PRICING[cycle as keyof typeof PRICING];
      if (soloAmount) soloAmount.textContent = data.solo.amount;
      if (soloPeriod) soloPeriod.textContent = data.solo.period;
      if (soloTotal) soloTotal.textContent = data.solo.total;
      if (soloPix) soloPix.textContent = data.solo.pix;

      if (clinicAmount) clinicAmount.textContent = data.clinic.amount;
      if (clinicPeriod) clinicPeriod.textContent = data.clinic.period;
      if (clinicTotal) clinicTotal.textContent = data.clinic.total;
      if (clinicPix) clinicPix.textContent = data.clinic.pix;
    });
  });
</script>
